             </li>\n                            <li class=\"flex items-center gap-6\" data-kid=\"200\">\n                                <span class=\"text-[#22C55E]\" data-kid=\"201\">[X]</span>\n                                <span class=\"text-[#A1A1AA]\" data-kid=\"202\">Style Guide Enforcement</span>\n                            </li>\n                            <li class=\"flex items-center gap-6\" data-kid=\"203\">\n                                <span class=\"text-[#22C55E]\" data-kid=\"204\">[X]</span>\n                                <span class=\"text-[#A1A1AA]\" data-kid=\"205\">Unit Test Suggestions</span>\n                            </li>\n                            <li class=\"flex items-center gap-6 text-[#EF4444]\" data-kid=\"206\">\n                                <span data-kid=\"207\">[ ]</span>\n                                <span data-kid=\"208\">Architectural Side Effects</span>\n                            </li>\n                            <li class=\"flex items-center gap-6 text-[#EF4444]\" data-kid=\"209\">\n                                <span data-kid=\"210\">[ ]</span>\n                                <span data-kid=\"211\">System Blast Radius Analysis</span>\n                            </li>\n                        </ul>\n                    </div>\n\n                    <div class=\"p-16 space-y-12 bg-black relative\" data-kid=\"212\">\n                        <div class=\"absolute top-0 right-0 px-6 py-2 bg-[#22C55E] text-black font-mono text-[10px] font-bold\" data-kid=\"213\">SYSTEM_OPTIMIZED</div>\n                        <div class=\"flex items-center gap-4 border-b border-[#262626] pb-6\" data-kid=\"214\">\n                            <i class=\"ti ti-terminal text-2xl text-[#22C55E]\" data-kid=\"215\"></i>\n                            <span class=\"font-mono font-bold uppercase tracking-widest text-[#22C55E]\" data-kid=\"216\">GrepAI Risk Engine</span>\n                        </div>\n                        <ul class=\"space-y-8 font-mono text-sm\" data-kid=\"217\">\n                            <li class=\"flex items-center gap-6\" data-kid=\"218\">\n                                <span class=\"text-[#22C55E]\" data-kid=\"219\">[X]</span>\n                                <span data-kid=\"220\">Cross-file Context Awareness</span>\n                            </li>\n                            <li class=\"flex items-center gap-6\" data-kid=\"221\">\n                                <span class=\"text-[#22C55E]\" data-kid=\"222\">[X]</span>\n                                <span data-kid=\"223\">Production Impact Traceability</span>\n                            </li>\n                            <li class=\"flex items-center gap-6\" data-kid=\"224\">\n                                <span class=\"text-[#22C55E]\" data-kid=\"225\">[X]</span>\n                                <span data-kid=\"226\">Dependency Violation Guard</span>\n                            </li>\n                            <li class=\"flex items-center gap-6\" data-kid=\"227\">\n                                <span class=\"text-[#22C55E]\" data-kid=\"228\">[X]</span>\n                                <span data-kid=\"229\">Architectural Debt Analysis</span>\n                            </li>\n                            <li class=\"flex items-center gap-6\" data-kid=\"230\">\n                                <span class=\"text-[#22C55E]\" data-kid=\"231\">[X]</span>\n                                <span data-kid=\"232\">Production Failure Prevention</span>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 px-6 lg:px-20 border-b border-[#262626]\" id=\"reports\" data-kid=\"233\">\n            <div class=\"max-w-[1440px] mx-auto space-y-16\" data-kid=\"234\">\n                <div class=\"flex items-end justify-between reveal-section\" data-kid=\"235\">\n                    <div class=\"space-y-4\" data-kid=\"236\">\n                        <h2 class=\"font-mono text-3xl uppercase font-bold tracking-tighter\" data-kid=\"237\">Analysis Archives</h2>\n                        <p class=\"text-[#A1A1AA]\" data-kid=\"238\">Realistic findings from production-grade pull requests.</p>\n                    </div>\n                    <div class=\"hidden lg:block font-mono text-[10px] text-[#262626] tracking-widest uppercase\" data-kid=\"239\">\n                        Real-time feed active...\n                    </div>\n                </div>\n\n                <div class=\"columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6 risk-cards\" data-kid=\"240\">\n                    \n                    <div class=\"risk-card break-inside-avoid bg-[#111111] border border-[#262626] p-8 flex flex-col gap-6 font-mono text-[11px] hover:border-[#22C55E]\" data-kid=\"241\">\n                        <div class=\"flex justify-between items-center border-b border-[#262626] pb-4\" data-kid=\"242\">\n                            <span class=\"text-[#A1A1AA]\" data-kid=\"243\">ID: #1423</span>\n                            <span class=\"text-[#EF4444] font-bold\" data-kid=\"244\">CRITICAL_RISK</span>\n                        </div>\n                        <div class=\"text-sm font-sans font-bold text-[#FAFAFA]\" data-kid=\"245\">Memory leak detected in Postgres worker cluster.</div>\n                        <div class=\"space-y-2 text-[#A1A1AA]\" data-kid=\"246\">\n                            <div class=\"flex justify-between\" data-kid=\"247\"><span data-kid=\"248\">CONFIDENCE:</span> <span class=\"text-[#22C55E]\" data-kid=\"249\">91%</span></div>\n                            <div class=\"flex justify-between\" data-kid=\"250\"><span data-kid=\"251\">IMPACT:</span> <span data-kid=\"252\">4 FILES / 2 SERVICES</span></div>\n                        </div>\n                        <div class=\"p-4 bg-black border-l-2 border-[#EF4444] italic\" data-kid=\"253\">\n                            Unclosed cursor detected in transaction block within 'batch_worker.go'. High probability of OOM under peak load.\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"risk-card break-inside-avoid bg-[#111111] border border-[#262626] p-8 flex flex-col gap-6 font-mono text-[11px] hover:border-[#22C55E]\" data-kid=\"254\">\n                        <div class=\"flex justify-between items-center border-b border-[#262626] pb-4\" data-kid=\"255\">\n                            <span class=\"text-[#A1A1AA]\" data-kid=\"256\">ID: #1430</span>\n                            <span class=\"text-[#F59E0B] font-bold\" data-kid=\"257\">MEDIUM_RISK</span>\n                        </div>\n                        <div class=\"text-sm font-sans font-bold text-[#FAFAFA]\" data-kid=\"258\">Migration: Add user_id to event_logs schema.</div>\n                        <div class=\"space-y-4\" data-kid=\"259\">\n                            <div class=\"space-y-1\" data-kid=\"260\">\n                                <div class=\"text-[#A1A1AA] uppercase text-[9px]\" data-kid=\"261\">Schema Visualization</div>\n                                <div class=\"h-24 w-full bg-black flex items-end gap-1 p-2 border border-[#262626]\" data-kid=\"262\">\n                                    <div class=\"bg-[#262626] flex-1 h-[60%]\" data-kid=\"263\"></div>\n                                    <div class=\"bg-[#262626] flex-1 h-[80%]\" data-kid=\"264\"></div>\n                                    <div class=\"bg-[#F59E0B]/50 flex-1 h-[95%] border-t border-[#F59E0B]\" data-kid=\"265\"></div>\n                                    <div class=\"bg-[#262626] flex-1 h-[40%]\" data-kid=\"266\"></div>\n                                    <div class=\"bg-[#262626] flex-1 h-[70%]\" data-kid=\"267\"></div>\n                                </div>\n                            </div>\n                            <p class=\"text-[#A1A1AA]\" data-kid=\"268\">\n                                Index missing on 'user_id' in event_logs table. Large table scan detected for downstream analytics dashboard.\n                            </p>\n                            <div class=\"pt-4 border-t border-[#262626] flex gap-2 flex-wrap\" data-kid=\"269\">\n                                <span class=\"bg-black border border-[#262626] px-2 py-0.5 text-[9px]\" data-kid=\"270\">SQL_PERF</span>\n                                <span class=\"bg-black border border-[#262626] px-2 py-0.5 text-[9px]\" data-kid=\"271\">DBA_ALERT</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"risk-card break-inside-avoid bg-[#111111] border border-[#262626] p-8 flex flex-col gap-6 font-mono text-[11px] hover:border-[#22C55E]\" data-kid=\"272\">\n                        <div class=\"flex justify-between items-center border-b border-[#262626] pb-4\" data-kid=\"273\">\n                            <span class=\"text-[#A1A1AA]\" data-kid=\"274\">ID: #1418</span>\n                            <span class=\"text-[#22C55E] font-bold\" data-kid=\"275\">LOW_RISK</span>\n                        </div>\n                        <div class=\"text-sm font-sans font-bold text-[#FAFAFA]\" data-kid=\"276\">Routine update: lodash v4.17.21</div>\n                        <div class=\"space-y-2 text-[#A1A1AA]\" data-kid=\"277\">\n                            <div class=\"flex justify-between\" data-kid=\"278\"><span data-kid=\"279\">CONFIDENCE:</span> <span class=\"text-[#22C55E]\" data-kid=\"280\">98.2%</span></div>\n                        </div>\n                        <p class=\"text-[#A1A1AA]\" data-kid=\"281\">\n                            Standard dependency bump. No breaking changes detected in used methods. Security audit: CLEAR.\n                        </p>\n                    </div>\n\n                    \n                    <div class=\"risk-card break-inside-avoid bg-[#111111] border border-[#262626] p-8 flex flex-col gap-6 font-mono text-[11px] hover:border-[#22C55E]\" data-kid=\"282\">\n                        <div class=\"flex justify-between items-center border-b border-[#262626] pb-4\" data-kid=\"283\">\n                            <span class=\"text-[#A1A1AA]\" data-kid=\"284\">ID: #1442</span>\n                            <span class=\"text-[#EF4444] font-bold\" data-kid=\"285\">CRITICAL_RISK</span>\n                        </div>\n                        <div class=\"text-sm font-sans font-bold text-[#FAFAFA]\" data-kid=\"286\">Refactor of authentication middleware.</div>\n                        <div class=\"p-3 bg-[#EF4444]/5 border border-[#EF4444]/20 text-[#EF4444]\" data-kid=\"287\">\n                            Potential session hijacking vulnerability in high-availability setup. Token signing secret exposed to logger in debug mode.\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 px-6 lg:px-20 border-b border-[#262626]\" id=\"security\" data-kid=\"288\">\n            <div class=\"max-w-[1440px] mx-auto space-y-20\" data-kid=\"289\">\n                <div class=\"space-y-4 reveal-section\" data-kid=\"290\">\n                    <h2 class=\"font-mono text-xs uppercase tracking-widest text-[#22C55E]\" data-kid=\"291\">Engineering Specs</h2>\n                    <h3 class=\"font-mono text-4xl lg:text-5xl uppercase font-bold tracking-tighter\" data-kid=\"292\">Security & Trust Specification</h3>\n                </div>\n\n                <div class=\"border-t border-[#262626]\" data-kid=\"293\">\n                    <div class=\"grid lg:grid-cols-[1fr_2fr_1fr] py-12 border-b border-[#262626] items-center gap-12 group transition-colors hover:bg-[#111111]\" data-kid=\"294\">\n                        <div class=\"font-mono font-bold text-lg uppercase group-hover:text-[#22C55E]\" data-kid=\"295\">GITHUB_NATIVE</div>\n                        <div class=\"text-[#A1A1AA] text-sm leading-relaxed max-w-xl\" data-kid=\"296\">\n                            Integrated directly into the GitHub ecosystem. We process pull requests via secure webhooks and deliver findings as standard GitHub Checks and comments.\n                        </div>\n                        <div class=\"font-mono text-[10px] text-right text-[#22C55E] tracking-widest border border-[#22C55E]/30 px-4 py-2 self-start lg:self-center\" data-kid=\"297\">ZERO_FRICTION</div>\n                    </div>\n                    <div class=\"grid lg:grid-cols-[1fr_2fr_1fr] py-12 border-b border-[#262626] items-center gap-12 group transition-colors hover:bg-[#111111]\" data-kid=\"298\">\n                        <div class=\"font-mono font-bold text-lg uppercase group-hover:text-[#22C55E]\" data-kid=\"299\">ZERO_RETENTION</div>\n                        <div class=\"text-[#A1A1AA] text-sm leading-relaxed max-w-xl\" data-kid=\"300\">\n                            Source code is never persisted. Analysis is performed in transient, memory-only execution environments that are destroyed immediately after feedback.\n                        </div>\n                        <div class=\"font-mono text-[10px] text-right text-[#22C55E] tracking-widest border border-[#22C55E]/30 px-4 py-2 self-start lg:self-center\" data-kid=\"301\">COMPLIANT</div>\n                    </div>\n                    <div class=\"grid lg:grid-cols-[1fr_2fr_1fr] py-12 border-b border-[#262626] items-center gap-12 group transition-colors hover:bg-[#111111]\" data-kid=\"302\">\n                        <div class=\"font-mono font-bold text-lg uppercase group-hover:text-[#22C55E]\" data-kid=\"303\">SCOPED_ACCESS</div>\n                        <div class=\"text-[#A1A1AA] text-sm leading-relaxed max-w-xl\" data-kid=\"304\">\n                            Fine-grained permissions ensure we only access the necessary file metadata and repository structure required for impact analysis. No excessive scopes.\n                        </div>\n                        <div class=\"font-mono text-[10px] text-right text-[#22C55E] tracking-widest border border-[#22C55E]/30 px-4 py-2 self-start lg:self-center\" data-kid=\"305\">ISO_27001_READY</div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 px-6 lg:px-20 relative overflow-hidden\" data-kid=\"306\">\n            <div class=\"absolute inset-0 z-0 bg-[radial-gradient(circle_at_50%_120%,rgba(34,197,94,0.05)_0%,transparent_50%)]\" data-kid=\"307\"></div>\n            <div class=\"max-w-[1440px] mx-auto relative z-10 space-y-16\" data-kid=\"308\">\n                <div class=\"space-y-8 max-w-4xl reveal-section\" data-kid=\"309\">\n                    <h2 class=\"font-mono text-6xl lg:text-[120px] leading-[0.85] tracking-tighter uppercase font-bold\" data-kid=\"310\">\n                        Review the system,<br data-kid=\"311\">\n                        <span class=\"text-[#22C55E]\" data-kid=\"312\">not just the diff.</span>\n                    </h2>\n                    <p class=\"text-[#A1A1AA] text-xl lg:text-2xl font-light max-w-2xl leading-relaxed\" data-kid=\"313\">\n                        Join engineering teams who prioritize production stability. Connect a repository today and receive your first analysis in under 60 seconds.\n                    </p>\n                </div>\n\n                <div class=\"flex flex-col md:flex-row items-center gap-8 pt-10 reveal-section\" data-kid=\"314\">\n                    <button class=\"bg-[#22C55E] text-[#0A0A0A] font-mono px-12 py-6 font-bold text-lg hover:brightness-110 active:scale-95 transition-all\" data-kid=\"315\">\n                        CONNECT REPOSITORY\n                    </button>\n                    <div class=\"bg-[#111111] border border-[#262626] px-8 py-5 flex items-center gap-4 font-mono text-sm group\" data-kid=\"316\">\n                        <span class=\"text-[#22C55E] font-bold\" data-kid=\"317\">$</span>\n                        <span class=\"text-[#FAFAFA]\" data-kid=\"318\">curl -sSL get.grep.ai | sh</span>\n                        <button class=\"text-[#A1A1AA] hover:text-[#22C55E] transition-colors ml-4 cursor-pointer\" data-kid=\"319\">\n                            <i class=\"ti ti-copy\" data-kid=\"320\"></i>\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"pt-24 grid grid-cols-2 lg:grid-cols-4 gap-8 font-mono text-[10px] text-[#262626] uppercase tracking-[0.3em]\" data-kid=\"321\">\n                    <div data-kid=\"322\">&copy; 2024 GREPAI INC.</div>\n                    <div data-kid=\"323\">BUILD_VERSION 2.4.9-STABLE</div>\n                    <div data-kid=\"324\">LATENCY &lt;18MS (CORE-EAST)</div>\n                    <div class=\"text-right\" data-kid=\"325\">ALL_SYSTEMS_OPERATIONAL</div>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"326\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"327\"></script>\n<script type=\"module\" data-kid=\"328\">\n    import { animate, inView, scroll, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n    import Lenis from \"https://esm.sh/lenis@1\"\n\n    // Initial GSAP Setup\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Smooth Scrolling\n    const lenis = new Lenis();\n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    // Hero Text Entrances\n    gsap.from(\".hero-reveal\", {\n        y: 40,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.1,\n        ease: \"power4.out\"\n    });\n\n    // Terminal Entrance\n    gsap.from(\".hero-terminal\", {\n        scale: 0.98,\n        opacity: 0,\n        y: 20,\n        duration: 1.2,\n        delay: 0.5,\n        ease: \"power2.out\"\n    });\n\n    // Improved Typewriter Effect for Terminal Findings\n    const terminalLines = document.querySelectorAll('.typewriter-text');\n    terminalLines.forEach(line => {\n        const text = line.innerText;\n        line.innerText = '';\n        line.style.visibility = 'visible'; // Ensure it's not hidden if it was\n        \n        let i = 0;\n        const type = () => {\n            if (i < text.length) {\n                line.innerText += text.charAt(i);\n                i++;\n                // Randomize slightly for realistic CLI feel\n                setTimeout(type, 15 + Math.random() * 30);\n            }\n        };\n        // ScrollTrigger to start typewriter when terminal is in view\n        ScrollTrigger.create({\n            trigger: \".hero-terminal\",\n            start: \"top 80%\",\n            onEnter: () => setTimeout(type, 800)\n        });\n    });\n\n    // Scroll Batching for cards\n    ScrollTrigger.batch(\".risk-card\", {\n        onEnter: batch => gsap.to(batch, {\n            autoAlpha: 1, \n            y: 0, \n            stagger: 0.1, \n            overwrite: true,\n            duration: 0.6,\n            ease: \"power2.out\"\n        }),\n        start: \"top 85%\"\n    });\n\n    // Count up for stats\n    inView(\".stat\", el => {\n        const target = parseInt(el.dataset.target);\n        animate(0, target, {\n            duration: 2,\n            onUpdate: latest => el.innerText = Math.round(latest)\n        });\n    });\n\n    // Section Reveals\n    const revealSections = document.querySelectorAll('.reveal-section');\n    revealSections.forEach(section => {\n        gsap.from(section, {\n            scrollTrigger: {\n                trigger: section,\n                start: \"top 80%\",\n            },\n            y: 30,\n            opacity: 0,\n            duration: 1,\n            ease: \"power3.out\"\n        });\n    });\n\n    // SVG Graph Animation\n    inView(\".graph-container\", () => {\n        gsap.from(\".graph-lines path\", {\n            strokeDasharray: 300,\n            strokeDashoffset: 300,\n            duration: 2,\n            stagger: 0.2,\n            ease: \"power1.inOut\"\n        });\n        gsap.from(\".node-main, .node-impact, .node-critical\", {\n            scale: 0,\n            transformOrigin: \"center center\",\n            duration: 0.8,\n            stagger: 0.1,\n            ease: \"back.out(1.7)\"\n        });\n    });\n\n    // Nav Bar color shift on scroll\n    scroll(({ y }) => {\n        const header = document.querySelector('header');\n        if (y.current > 100) {\n            header.style.backgroundColor = \"rgba(10, 10, 10, 0.95)\";\n            header.style.backdropFilter = \"blur(8px)\";\n        } else {\n            header.style.backgroundColor = \"#0A0A0A\";\n            header.style.backdropFilter = \"none\";\n        }\n    });\n\n</script>\n",
