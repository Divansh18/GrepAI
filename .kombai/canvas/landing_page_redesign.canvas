      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --bg: #0A0A0A;\n        --panel: #111111;\n        --border: #262626;\n        --text: #FAFAFA;\n        --muted: #A1A1AA;\n        --accent: #22C55E;\n    }\n\n    body {\n        background-color: var(--bg);\n        color: var(--text);\n        font-family: 'DM Sans', sans-serif;\n        margin: 0;\n        -webkit-font-smoothing: antialiased;\n        overflow-x: clip;\n    }\n\n    h1, h2, h3, h4, .font-inter {\n        font-family: 'Inter', sans-serif;\n    }\n\n    .border-subtle { border-color: var(--border); }\n    .bg-panel { background-color: var(--panel); }\n    \n    /* Custom Scrollbar */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: var(--bg); }\n    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }\n    ::-webkit-scrollbar-thumb:hover { background: var(--muted); }\n\n    .workflow-line {\n        position: absolute;\n        left: 50%;\n        top: 0;\n        bottom: 0;\n        width: 1px;\n        background: linear-gradient(to bottom, transparent, var(--border), var(--accent), var(--border), transparent);\n        transform: translateX(-50%);\n    }\n\n    .workflow-dot {\n        position: absolute;\n        left: 50%;\n        width: 12px;\n        height: 12px;\n        background: var(--accent);\n        border-radius: 50%;\n        transform: translate(-50%, -50%);\n        box-shadow: 0 0 20px var(--accent);\n        z-index: 20;\n    }\n</style>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n\n<div id=\"smooth-wrapper\" data-kid=\"2\">\n    <div id=\"smooth-content\" data-kid=\"3\">\n        \n        <header class=\"fixed top-0 left-0 w-full z-50 border-b border-[#262626] bg-[#0A0A0A]/80 backdrop-blur-md\" data-kid=\"4\">\n            <nav class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"5\">\n                <div class=\"flex items-center gap-10\" data-kid=\"6\">\n                    <a href=\"/\" class=\"text-xl font-bold font-inter tracking-tighter flex items-center gap-2\" data-kid=\"7\">\n                        <i class=\"ti ti-binary text-[#22C55E]\" data-kid=\"8\"></i>\n                        GREPAI\n                    </a>\n                    <div class=\"hidden lg:flex gap-8 text-sm font-medium text-[#A1A1AA]\" data-kid=\"9\">\n                        <a href=\"#product\" class=\"hover:text-white transition-colors\" data-kid=\"10\">Product</a>\n                        <a href=\"#workflow\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Workflow</a>\n                        <a href=\"#security\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Security</a>\n                        <a href=\"#docs\" class=\"hover:text-white transition-colors\" data-kid=\"13\">Docs</a>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"14\">\n                    <a href=\"https://github.com\" class=\"text-[#A1A1AA] hover:text-white transition-colors\" data-kid=\"15\">\n                        <i class=\"ti ti-brand-github text-xl\" data-kid=\"16\"></i>\n                    </a>\n                    <button class=\"bg-[#22C55E] text-[#0A0A0A] px-4 py-2 rounded text-sm font-bold font-inter cursor-pointer\" data-kid=\"17\">\n                        Connect Repository\n                    </button>\n                </div>\n            </nav>\n        </header>\n\n        \n        <section id=\"product\" class=\"pt-40 pb-32 px-6\" data-kid=\"18\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"19\">\n                <div class=\"text-center mb-20 max-w-4xl mx-auto\" data-kid=\"20\">\n                    <h1 class=\"text-5xl md:text-7xl font-bold font-inter mb-6 leading-[1.1] tracking-tight\" data-kid=\"21\">\n                        Repository-aware<br data-kid=\"22\"><span class=\"text-[#22C55E]\" data-kid=\"23\">PR risk analysis.</span>\n                    </h1>\n                    <p class=\"text-xl text-[#A1A1AA] max-w-2xl mx-auto leading-relaxed\" data-kid=\"24\">\n                        Understand the blast radius of a change before it reaches production. Built for senior engineers.\n                    </p>\n                </div>\n\n                \n                <div class=\"bg-[#111111] border border-[#262626] rounded-xl overflow-hidden shadow-[0_32px_64px_-16px_rgba(0,0,0,0.5)] flex flex-col md:flex-row h-auto md:h-[700px] font-mono text-sm overflow-x-auto\" data-kid=\"25\">\n                    \n                    <div class=\"hidden md:flex w-16 border-r border-[#262626] flex-col items-center py-6 gap-6 bg-[#0d0d0d]\" data-kid=\"26\">\n                        <i class=\"ti ti-files text-[#A1A1AA] text-xl cursor-pointer hover:text-white\" data-kid=\"27\"></i>\n                        <i class=\"ti ti-git-pull-request text-[#22C55E] text-xl cursor-pointer\" data-kid=\"28\"></i>\n                        <i class=\"ti ti-search text-[#A1A1AA] text-xl cursor-pointer hover:text-white\" data-kid=\"29\"></i>\n                        <div class=\"mt-auto pb-4\" data-kid=\"30\">\n                            <i class=\"ti ti-settings text-[#A1A1AA] text-xl cursor-pointer hover:text-white\" data-kid=\"31\"></i>\n                        </div>\n                    </div>\n                    \n                    \n                    <div class=\"hidden lg:flex w-64 border-r border-[#262626] flex-col bg-[#0f0f0f]\" data-kid=\"32\">\n                        <div class=\"p-3 border-b border-[#262626] text-[10px] uppercase tracking-widest text-[#A1A1AA] font-bold\" data-kid=\"33\">Explorer</div>\n                        <div class=\"p-4 space-y-2 overflow-y-auto\" data-kid=\"34\">\n                            <div class=\"flex items-center gap-2 text-[#A1A1AA]\" data-kid=\"35\"><i class=\"ti ti-folder\" data-kid=\"36\"></i> src</div>\n                            <div class=\"pl-4 space-y-2\" data-kid=\"37\">\n                                <div class=\"flex items-center gap-2 text-[#A1A1AA]\" data-kid=\"38\"><i class=\"ti ti-folder\" data-kid=\"39\"></i> services</div>\n                                <div class=\"pl-4 flex items-center gap-2 text-[#22C55E] bg-[#22C55E]/10 border-l border-[#22C55E] -ml-4 pl-5 py-1\" data-kid=\"40\"><i class=\"ti ti-brand-typescript\" data-kid=\"41\"></i> auth.service.ts</div>\n                                <div class=\"pl-4 flex items-center gap-2 text-[#A1A1AA]\" data-kid=\"42\"><i class=\"ti ti-brand-typescript\" data-kid=\"43\"></i> billing.ts</div>\n                            </div>\n                            <div class=\"flex items-center gap-2 text-[#A1A1AA]\" data-kid=\"44\"><i class=\"ti ti-file-code\" data-kid=\"45\"></i> package.json</div>\n                            <div class=\"flex items-center gap-2 text-[#A1A1AA]\" data-kid=\"46\"><i class=\"ti ti-settings\" data-kid=\"47\"></i> tsconfig.json</div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"flex-1 flex flex-col bg-[#0d0d0d] min-w-[320px]\" data-kid=\"48\">\n                        <div class=\"h-10 border-b border-[#262626] bg-[#111111] flex items-center px-4 gap-4 text-xs font-inter overflow-x-auto whitespace-nowrap\" data-kid=\"49\">\n                            <div class=\"text-[#FAFAFA] border-b-2 border-[#22C55E] h-full flex items-center px-3 font-semibold\" data-kid=\"50\">PR #842: Analysis</div>\n                            <div class=\"text-[#A1A1AA] px-3 cursor-pointer hover:text-white border-l border-[#262626] h-1/2 flex items-center\" data-kid=\"51\">Diff View</div>\n                            <div class=\"text-[#A1A1AA] px-3 cursor-pointer hover:text-white border-l border-[#262626] h-1/2 flex items-center\" data-kid=\"52\">Impact Map</div>\n                            <div class=\"text-[#A1A1AA] px-3 cursor-pointer hover:text-white border-l border-[#262626] h-1/2 flex items-center\" data-kid=\"53\">Security (2)</div>\n                        </div>\n                        \n                        <div class=\"p-10 overflow-y-auto scroll-smooth\" data-kid=\"54\">\n                            <div class=\"flex justify-between items-start mb-12\" data-kid=\"55\">\n                                <div data-kid=\"56\">\n                                    <div class=\"inline-flex items-center gap-2 px-2 py-0.5 rounded bg-[#262626] text-[10px] text-[#A1A1AA] mb-4\" data-kid=\"57\">\n                                        <i class=\"ti ti-git-branch\" data-kid=\"58\"></i> feature/auth-refactor-v2\n                                    </div>\n                                    <h2 class=\"text-3xl font-bold font-inter text-[#FAFAFA] tracking-tight\" data-kid=\"59\">Refactor authentication middleware</h2>\n                                    <p class=\"text-[#A1A1AA] mt-2 text-base\" data-kid=\"60\">Structural changes detected in token validation logic.</p>\n                                </div>\n                                <div class=\"flex items-center gap-8 bg-[#1a1a1a] p-4 rounded-lg border border-[#262626]\" data-kid=\"61\">\n                                    <div class=\"text-center\" data-kid=\"62\">\n                                        <div class=\"text-[10px] uppercase text-[#A1A1AA] font-bold mb-1\" data-kid=\"63\">Risk Score</div>\n                                        <div class=\"text-3xl font-bold text-red-500\" data-kid=\"64\">HIGH</div>\n                                    </div>\n                                    <div class=\"w-[1px] h-10 bg-[#262626]\" data-kid=\"65\"></div>\n                                    <div class=\"text-center\" data-kid=\"66\">\n                                        <div class=\"text-[10px] uppercase text-[#A1A1AA] font-bold mb-1\" data-kid=\"67\">Confidence</div>\n                                        <div class=\"text-3xl font-bold text-[#22C55E]\" data-kid=\"68\">92%</div>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class=\"grid grid-cols-1 xl:grid-cols-2 gap-8 mb-12\" data-kid=\"69\">\n                                <div class=\"border border-[#262626] rounded-xl p-6 bg-[#111111]/50\" data-kid=\"70\">\n                                    <h3 class=\"text-xs font-bold uppercase text-[#A1A1AA] mb-6 flex items-center gap-2\" data-kid=\"71\">\n                                        <i class=\"ti ti-topology-star-3\" data-kid=\"72\"></i> Affected Systems\n                                    </h3>\n                                    <ul class=\"space-y-4\" data-kid=\"73\">\n                                        <li class=\"flex items-center justify-between p-2 rounded hover:bg-white/5 transition-colors\" data-kid=\"74\">\n                                            <span class=\"text-[#FAFAFA] flex items-center gap-2\" data-kid=\"75\"><i class=\"ti ti-shield\" data-kid=\"76\"></i> Auth Service</span>\n                                            <span class=\"text-xs px-2 py-0.5 rounded bg-red-500/10 text-red-400 font-bold uppercase\" data-kid=\"77\">Critical</span>\n                                        </li>\n                                        <li class=\"flex items-center justify-between p-2 rounded hover:bg-white/5 transition-colors\" data-kid=\"78\">\n                                            <span class=\"text-[#FAFAFA] flex items-center gap-2\" data-kid=\"79\"><i class=\"ti ti-database\" data-kid=\"80\"></i> Session Storage</span>\n                                            <span class=\"text-xs px-2 py-0.5 rounded bg-yellow-500/10 text-yellow-400 font-bold uppercase\" data-kid=\"81\">Medium</span>\n                                        </li>\n                                        <li class=\"flex items-center justify-between p-2 rounded hover:bg-white/5 transition-colors\" data-kid=\"82\">\n                                            <span class=\"text-[#FAFAFA] flex items-center gap-2\" data-kid=\"83\"><i class=\"ti ti-credit-card\" data-kid=\"84\"></i> Billing Gateway</span>\n                                            <span class=\"text-xs px-2 py-0.5 rounded bg-red-500/10 text-red-400 font-bold uppercase\" data-kid=\"85\">Critical</span>\n                                        </li>\n                                    </ul>\n                                </div>\n                                <div class=\"border border-[#262626] rounded-xl p-6 bg-[#111111]/50\" data-kid=\"86\">\n                                    <h3 class=\"text-xs font-bold uppercase text-[#A1A1AA] mb-6 flex items-center gap-2\" data-kid=\"87\">\n                                        <i class=\"ti ti-chart-dots\" data-kid=\"88\"></i> System Impact Metrics\n                                    </h3>\n                                    <div class=\"space-y-6\" data-kid=\"89\">\n                                        <div data-kid=\"90\">\n                                            <div class=\"flex justify-between text-xs mb-2\" data-kid=\"91\">\n                                                <span class=\"text-[#A1A1AA]\" data-kid=\"92\">Blast Radius Potential</span>\n                                                <span class=\"text-[#FAFAFA]\" data-kid=\"93\">74% of Core Services</span>\n                                            </div>\n                                            <div class=\"h-1.5 bg-[#262626] rounded-full overflow-hidden\" data-kid=\"94\">\n                                                <div class=\"h-full bg-red-500 w-[74%]\" data-kid=\"95\"></div>\n                                            </div>\n                                        </div>\n                                        <div data-kid=\"96\">\n                                            <div class=\"flex justify-between text-xs mb-2\" data-kid=\"97\">\n                                                <span class=\"text-[#A1A1AA]\" data-kid=\"98\">Propagated Dependencies</span>\n                                                <span class=\"text-[#FAFAFA]\" data-kid=\"99\">28 direct, 114 indirect</span>\n                                            </div>\n                                            <div class=\"h-1.5 bg-[#262626] rounded-full overflow-hidden\" data-kid=\"100\">\n                                                <div class=\"h-full bg-[#22C55E] w-[45%]\" data-kid=\"101\"></div>\n                                            </div>\n                                        </div>\n                                        <div class=\"flex justify-between items-center pt-2\" data-kid=\"102\">\n                                            <span class=\"text-xs text-[#A1A1AA]\" data-kid=\"103\">Analysis Latency</span>\n                                            <span class=\"text-lg font-bold text-[#FAFAFA]\" data-kid=\"104\">18.4s</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class=\"border border-[#262626] rounded-xl p-6 bg-[#111111]/50\" data-kid=\"105\">\n                                <h3 class=\"text-xs font-bold uppercase text-[#A1A1AA] mb-6 flex items-center gap-2\" data-kid=\"106\">\n                                    <i class=\"ti ti-list-details\" data-kid=\"107\"></i> Actionable Findings\n                                </h3>\n                                <div class=\"space-y-6\" data-kid=\"108\">\n                                    <div class=\"flex gap-4 p-4 rounded-lg bg-red-500/5 border border-red-500/10\" data-kid=\"109\">\n                                        <i class=\"ti ti-alert-triangle text-red-500 text-xl shrink-0\" data-kid=\"110\"></i>\n                                        <div data-kid=\"111\">\n                                            <div class=\"text-[#FAFAFA] font-bold mb-1\" data-kid=\"112\">Token invalidation path modified</div>\n                                            <div class=\"text-[#A1A1AA] text-sm leading-relaxed\" data-kid=\"113\">Changes in `auth.service.ts` bypass the default expiry check for specific legacy endpoints. This could allow stale sessions to remain valid indefinitely.</div>\n                                        </div>\n                                    </div>\n                                    <div class=\"flex gap-4 p-4 rounded-lg bg-yellow-500/5 border border-yellow-500/10\" data-kid=\"114\">\n                                        <i class=\"ti ti-alert-circle text-yellow-500 text-xl shrink-0\" data-kid=\"115\"></i>\n                                        <div data-kid=\"116\">\n                                            <div class=\"text-[#FAFAFA] font-bold mb-1\" data-kid=\"117\">Session cache inconsistency risk</div>\n                                            <div class=\"text-[#A1A1AA] text-sm leading-relaxed\" data-kid=\"118\">Modified write order to Redis cache detected. This increases likelihood of race conditions during high-concurrency peak hours.</div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section id=\"workflow\" class=\"py-40 px-6 relative overflow-hidden\" data-kid=\"119\">\n            <div class=\"max-w-5xl mx-auto\" data-kid=\"120\">\n                <div class=\"text-center mb-32\" data-kid=\"121\">\n                    <h2 class=\"text-4xl font-bold font-inter mb-4\" data-kid=\"122\">Engineering Workflow</h2>\n                    <p class=\"text-[#A1A1AA]\" data-kid=\"123\">A technical analysis engine built for production systems.</p>\n                </div>\n\n                <div class=\"relative\" data-kid=\"124\">\n                    \n                    <div class=\"workflow-line hidden md:block\" data-kid=\"125\"></div>\n\n                    <div class=\"space-y-32 md:space-y-48\" data-kid=\"126\">\n                        \n                        <div class=\"flex flex-col md:flex-row items-center justify-between relative z-10 workflow-step\" data-kid=\"127\">\n                            <div class=\"w-full md:w-1/2 md:pr-20 text-center md:text-right mb-12 md:mb-0\" data-kid=\"128\">\n                                <span class=\"text-[#22C55E] font-mono text-xs font-bold uppercase tracking-widest mb-2 block\" data-kid=\"129\">Step 01</span>\n                                <h3 class=\"text-2xl font-bold font-inter mb-4\" data-kid=\"130\">Pull Request Trigger</h3>\n                                <p class=\"text-[#A1A1AA] leading-relaxed\" data-kid=\"131\">Developer opens a PR in GitHub. GrepAI intercepts the webhook and immediately clones an ephemeral copy of the repository for analysis.</p>\n                            </div>\n                            <div class=\"workflow-dot hidden md:block\" data-kid=\"132\"></div>\n                            <div class=\"w-full md:w-1/2 md:pl-20\" data-kid=\"133\">\n                                <div class=\"bg-[#111111] border border-[#262626] p-6 rounded-xl font-mono text-xs shadow-xl\" data-kid=\"134\">\n                                    <div class=\"flex items-center gap-3 mb-4 text-[#A1A1AA]\" data-kid=\"135\">\n                                        <i class=\"ti ti-git-pull-request text-[#22C55E] text-lg\" data-kid=\"136\"></i>\n                                        <span class=\"font-bold\" data-kid=\"137\">WEBHOOK RECEIVED</span>\n                                    </div>\n                                    <div class=\"bg-[#0A0A0A] p-3 border border-[#262626] rounded-lg text-[#FAFAFA]\" data-kid=\"138\">\n                                        <span class=\"text-purple-400\" data-kid=\"139\">repo</span>.analyze({<br data-kid=\"140\">\n                                        &nbsp;&nbsp;id: <span class=\"text-green-400\" data-kid=\"141\">\"PR-842\"</span>,<br data-kid=\"142\">\n                                        &nbsp;&nbsp;branch: <span class=\"text-green-400\" data-kid=\"143\">\"feat/auth\"</span><br data-kid=\"144\">\n                                        });\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"flex flex-col md:flex-row-reverse items-center justify-between relative z-10 workflow-step\" data-kid=\"145\">\n                            <div class=\"w-full md:w-1/2 md:pl-20 text-center md:text-left mb-12 md:mb-0\" data-kid=\"146\">\n                                <span class=\"text-[#22C55E] font-mono text-xs font-bold uppercase tracking-widest mb-2 block\" data-kid=\"147\">Step 02</span>\n                                <h3 class=\"text-2xl font-bold font-inter mb-4\" data-kid=\"148\">Dependency Graphing</h3>\n                                <p class=\"text-[#A1A1AA] leading-relaxed\" data-kid=\"149\">Our engine crawls the entire repository to build a multi-level dependency graph, identifying every function, service, and data-sink affected by the changes.</p>\n                            </div>\n                            <div class=\"workflow-dot hidden md:block\" data-kid=\"150\"></div>\n                            <div class=\"w-full md:w-1/2 md:pr-20\" data-kid=\"151\">\n                                <div class=\"bg-[#111111] border border-[#262626] p-6 rounded-xl h-48 flex items-center justify-center shadow-xl\" data-kid=\"152\">\n                                    <div class=\"relative flex items-center gap-8\" data-kid=\"153\">\n                                        <div class=\"w-12 h-12 rounded-lg border-2 border-[#22C55E] flex items-center justify-center text-[10px] font-bold bg-[#22C55E]/10\" data-kid=\"154\">CORE</div>\n                                        <div class=\"w-16 h-[2px] bg-gradient-to-r from-[#22C55E] to-red-500\" data-kid=\"155\"></div>\n                                        <div class=\"w-12 h-12 rounded-lg border-2 border-red-500 flex items-center justify-center text-[10px] font-bold bg-red-500/10\" data-kid=\"156\">SESS</div>\n                                        <div class=\"absolute -top-4 left-1/2 -translate-x-1/2 text-[10px] text-[#A1A1AA] font-mono\" data-kid=\"157\">MAP_REFS</div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"flex flex-col md:flex-row items-center justify-between relative z-10 workflow-step\" data-kid=\"158\">\n                            <div class=\"w-full md:w-1/2 md:pr-20 text-center md:text-right mb-12 md:mb-0\" data-kid=\"159\">\n                                <span class=\"text-[#22C55E] font-mono text-xs font-bold uppercase tracking-widest mb-2 block\" data-kid=\"160\">Step 03</span>\n                                <h3 class=\"text-2xl font-bold font-inter mb-4\" data-kid=\"161\">Risk Surface Assessment</h3>\n                                <p class=\"text-[#A1A1AA] leading-relaxed\" data-kid=\"162\">Analysis results are cross-referenced with architectural patterns and historical production failures to generate a high-confidence risk report.</p>\n                            </div>\n                            <div class=\"workflow-dot hidden md:block\" data-kid=\"163\"></div>\n                            <div class=\"w-full md:w-1/2 md:pl-20\" data-kid=\"164\">\n                                <div class=\"bg-[#111111] border border-[#262626] p-8 rounded-xl shadow-xl\" data-kid=\"165\">\n                                    <div class=\"h-3 w-full bg-[#262626] rounded-full overflow-hidden mb-4\" data-kid=\"166\">\n                                        <div class=\"h-full bg-red-500 w-[92%]\" data-kid=\"167\"></div>\n                                    </div>\n                                    <div class=\"flex justify-between items-center\" data-kid=\"168\">\n                                        <span class=\"text-xs font-bold text-[#A1A1AA]\" data-kid=\"169\">CRITICAL ANOMALY DETECTED</span>\n                                        <span class=\"text-lg font-bold text-red-500\" data-kid=\"170\">92%</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 px-6 bg-[#0f0f0f]\" data-kid=\"171\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"172\">\n                <div class=\"mb-16\" data-kid=\"173\">\n                    <h2 class=\"text-4xl font-bold font-inter mb-4\" data-kid=\"174\">System Awareness</h2>\n                    <p class=\"text-[#A1A1AA] text-lg\" data-kid=\"175\">We see beyond the diff. We see the system.</p>\n                </div>\n\n                <div class=\"flex flex-col gap-[1px] border border-[#262626] rounded-2xl overflow-hidden bg-[#262626] shadow-[0_32px_64px_-16px_rgba(0,0,0,0.5)]\" data-kid=\"176\">\n                    \n                    <div class=\"bg-[#0f0f0f] p-8 h-[400px] overflow-hidden relative\" data-kid=\"177\">\n                        <div class=\"absolute top-0 right-0 p-4 font-mono text-[10px] text-[#22C55E]/30 uppercase tracking-widest pointer-events-none\" data-kid=\"178\">\n                            CONTEXT_RECOGNITION: ENABLED\n                        </div>\n                        <div class=\"flex items-center gap-4 mb-6 border-b border-[#262626] pb-4\" data-kid=\"179\">\n                            <div class=\"flex gap-1.5\" data-kid=\"180\">\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-red-500/20\" data-kid=\"181\"></div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-yellow-500/20\" data-kid=\"182\"></div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-[#22C55E]/20\" data-kid=\"183\"></div>\n                            </div>\n                            <div class=\"h-4 w-[1px] bg-[#262626] mx-2\" data-kid=\"184\"></div>\n                            <i class=\"ti ti-brand-typescript text-blue-400\" data-kid=\"185\"></i>\n                            <span class=\"text-xs font-mono text-[#FAFAFA]\" data-kid=\"186\">src/services/auth.service.ts</span>\n                            <span class=\"ml-auto text-xs text-[#A1A1AA] font-mono\" data-kid=\"187\">Line 142</span>\n                        </div>\n                        <div class=\"font-mono text-sm leading-relaxed space-y-1\" data-kid=\"188\">\n                            <div class=\"text-[#41414a]\" data-kid=\"189\">141 | <span class=\"text-purple-400\" data-kid=\"190\">async function</span> <span class=\"text-blue-400\" data-kid=\"191\">validateToken</span>(token: <span class=\"text-yellow-400\" data-kid=\"192\">string</span>) {</div>\n                            <div class=\"bg-red-500/10 -mx-8 px-8 border-l-4 border-red-500\" data-kid=\"193\"><span class=\"text-red-400 font-bold\" data-kid=\"194\">-</span> 142 | &nbsp;&nbsp;<span class=\"text-purple-400\" data-kid=\"195\">if</span> (token === globalConfig.MASTER_KEY) <span class=\"text-purple-400\" data-kid=\"196\">return true</span>;</div>\n                            <div class=\"bg-[#22C55E]/10 -mx-8 px-8 border-l-4 border-[#22C55E]\" data-kid=\"197\"><span class=\"text-[#22C55E] font-bold\" data-kid=\"198\">+</span> 143 | &nbsp;&nbsp;<span class=\"text-purple-400\" data-kid=\"199\">if</span> (<span class=\"text-blue-400\" data-kid=\"200\">isWhitelisted</span>(token) &amp;&amp; !<span class=\"text-blue-400\" data-kid=\"201\">isExpired</span>(token)) <span class=\"text-purple-400\" data-kid=\"202\">return true</span>;</div>\n                            <div class=\"text-[#41414a]\" data-kid=\"203\">144 | &nbsp;&nbsp;<span class=\"text-purple-400\" data-kid=\"204\">return await</span> db.tokens.<span class=\"text-blue-400\" data-kid=\"205\">findUnique</span>({ where: { id: token } });</div>\n                            <div class=\"text-[#41414a]\" data-kid=\"206\">145 | }</div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"bg-[#111111] p-10 flex flex-col md:flex-row gap-12\" data-kid=\"207\">\n                        <div class=\"w-full md:w-1/3\" data-kid=\"208\">\n                            <div class=\"flex items-center gap-2 mb-4\" data-kid=\"209\">\n                                <div class=\"px-2 py-0.5 rounded bg-red-500/10 text-red-500 text-[10px] font-bold font-mono\" data-kid=\"210\">CRITICAL_IMPACT</div>\n                                <div class=\"px-2 py-0.5 rounded bg-[#262626] text-[#A1A1AA] text-[10px] font-bold font-mono\" data-kid=\"211\">14_FILES</div>\n                            </div>\n                            <h4 class=\"text-xs font-bold uppercase text-[#A1A1AA] mb-4 tracking-widest font-inter\" data-kid=\"212\">System Blast Radius</h4>\n                            <div class=\"text-4xl font-bold font-inter tracking-tighter\" data-kid=\"213\">14 affected files</div>\n                            <p class=\"text-sm text-[#A1A1AA] mt-4 leading-relaxed font-medium\" data-kid=\"214\">Changing `validateToken` signature forces re-evaluation of 3 core authentication flows and 11 indirect downstream data processors.</p>\n                        </div>\n                        <div class=\"flex-1 grid grid-cols-1 sm:grid-cols-2 gap-4\" data-kid=\"215\">\n                            <div class=\"p-5 border border-[#262626] rounded-xl flex items-center gap-5 hover:border-[#22C55E]/40 transition-all duration-300 group bg-[#0d0d0d] relative overflow-hidden\" data-kid=\"216\">\n                                <div class=\"absolute inset-0 bg-red-500/[0.02] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"217\"></div>\n                                <div class=\"w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center text-red-500 font-bold border border-red-500/20 z-10\" data-kid=\"218\">\n                                    <i class=\"ti ti-alert-triangle\" data-kid=\"219\"></i>\n                                </div>\n                                <div class=\"flex-1 z-10\" data-kid=\"220\">\n                                    <div class=\"text-sm font-bold font-mono text-[#FAFAFA] group-hover:text-red-400 transition-colors\" data-kid=\"221\">src/api/auth/login.ts</div>\n                                    <div class=\"text-[10px] text-[#A1A1AA] font-medium mt-1\" data-kid=\"222\">Directly imports modified function</div>\n                                </div>\n                                <i class=\"ti ti-chevron-right text-[#262626] group-hover:text-white transition-colors z-10\" data-kid=\"223\"></i>\n                            </div>\n                            <div class=\"p-5 border border-[#262626] rounded-xl flex items-center gap-5 hover:border-[#22C55E]/40 transition-all duration-300 group bg-[#0d0d0d]\" data-kid=\"224\">\n                                <div class=\"w-10 h-10 rounded-lg bg-yellow-500/10 flex items-center justify-center text-yellow-500 font-bold border border-yellow-500/20\" data-kid=\"225\">\n                                    <i class=\"ti ti-route-2\" data-kid=\"226\"></i>\n                                </div>\n                                <div class=\"flex-1\" data-kid=\"227\">\n                                    <div class=\"text-sm font-bold font-mono text-[#FAFAFA]\" data-kid=\"228\">src/lib/session.utils.ts</div>\n                                    <div class=\"text-[10px] text-[#A1A1AA] font-medium mt-1\" data-kid=\"229\">Secondary dependency propagation</div>\n                                </div>\n                                <i class=\"ti ti-chevron-right text-[#262626] group-hover:text-white transition-colors\" data-kid=\"230\"></i>\n                            </div>\n                            <div class=\"p-5 border border-[#262626] rounded-xl flex items-center gap-5 hover:border-[#22C55E]/40 transition-all duration-300 group bg-[#0d0d0d]\" data-kid=\"231\">\n                                <div class=\"w-10 h-10 rounded-lg bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E] font-bold border border-[#22C55E]/20\" data-kid=\"232\">\n                                    <i class=\"ti ti-circles\" data-kid=\"233\"></i>\n                                </div>\n                                <div class=\"flex-1\" data-kid=\"234\">\n                                    <div class=\"text-sm font-bold font-mono text-[#FAFAFA]\" data-kid=\"235\">src/middleware/guard.ts</div>\n                                    <div class=\"text-[10px] text-[#A1A1AA] font-medium mt-1\" data-kid=\"236\">Propagated type modification</div>\n                                </div>\n                                <i class=\"ti ti-chevron-right text-[#262626] group-hover:text-white transition-colors\" data-kid=\"237\"></i>\n                            </div>\n                            <div class=\"p-5 border border-[#262626] rounded-xl flex items-center gap-5 hover:border-[#22C55E]/40 transition-all duration-300 group bg-[#0d0d0d]\" data-kid=\"238\">\n                                <div class=\"w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center text-red-500 font-bold border border-red-500/20\" data-kid=\"239\">\n                                    <i class=\"ti ti-database-export\" data-kid=\"240\"></i>\n                                </div>\n                                <div class=\"flex-1\" data-kid=\"241\">\n                                    <div class=\"text-sm font-bold font-mono text-[#FAFAFA]\" data-kid=\"242\">src/services/billing.ts</div>\n                                    <div class=\"text-[10px] text-[#A1A1AA] font-medium mt-1\" data-kid=\"243\">Critical path dependency</div>\n                                </div>\n                                <i class=\"ti ti-chevron-right text-[#262626] group-hover:text-white transition-colors\" data-kid=\"244\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 px-6\" data-kid=\"245\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"246\">\n                <div class=\"flex flex-col md:flex-row justify-between items-end mb-16 gap-8\" data-kid=\"247\">\n                    <div class=\"max-w-xl\" data-kid=\"248\">\n                        <h2 class=\"text-4xl font-bold font-inter mb-4 leading-tight\" data-kid=\"249\">GrepAI vs. <span class=\"text-[#A1A1AA]\" data-kid=\"250\">Traditional AI Code Reviews</span></h2>\n                        <p class=\"text-[#A1A1AA] text-lg\" data-kid=\"251\">Engineers don't need help with variable naming. They need help with architectural integrity.</p>\n                    </div>\n                    <div class=\"flex gap-4\" data-kid=\"252\">\n                        <div class=\"flex items-center gap-2 text-sm text-[#A1A1AA]\" data-kid=\"253\">\n                            <span class=\"w-3 h-3 rounded-full bg-red-500\" data-kid=\"254\"></span> Risk Point\n                        </div>\n                        <div class=\"flex items-center gap-2 text-sm text-[#A1A1AA]\" data-kid=\"255\">\n                            <span class=\"w-3 h-3 rounded-full bg-[#22C55E]\" data-kid=\"256\"></span> Mitigation\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"border border-[#262626] rounded-2xl overflow-hidden shadow-2xl overflow-x-auto\" data-kid=\"257\">\n                    <table class=\"w-full border-collapse min-w-[800px]\" data-kid=\"258\">\n                        <thead data-kid=\"259\">\n                            <tr class=\"bg-[#111111] border-b border-[#262626]\" data-kid=\"260\">\n                                <th class=\"p-8 text-left font-inter font-bold text-sm border-r border-[#262626] w-1/3\" data-kid=\"261\">Core Capability</th>\n                                <th class=\"p-8 text-center font-inter font-bold text-sm text-[#A1A1AA] border-r border-[#262626]\" data-kid=\"262\">Traditional LLM Review</th>\n                                <th class=\"p-8 text-center font-inter font-bold text-sm text-[#22C55E]\" data-kid=\"263\">GrepAI Engine</th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"text-sm\" data-kid=\"264\">\n                            <tr class=\"border-b border-[#262626] group hover:bg-white/[0.03] transition-colors\" data-kid=\"265\">\n                                <td class=\"p-8 border-r border-[#262626] font-medium\" data-kid=\"266\">Style & Naming Suggestions</td>\n                                <td class=\"p-8 text-center border-r border-[#262626] text-[#22C55E]\" data-kid=\"267\"><i class=\"ti ti-check text-xl opacity-50\" data-kid=\"268\"></i></td>\n                                <td class=\"p-8 text-center text-[#22C55E]\" data-kid=\"269\"><i class=\"ti ti-check text-xl\" data-kid=\"270\"></i></td>\n                            </tr>\n                            <tr class=\"border-b border-[#262626] group hover:bg-white/5 transition-colors\" data-kid=\"271\">\n                                <td class=\"p-8 border-r border-[#262626] font-medium\" data-kid=\"272\">\n                                    Architectural Impact Analysis\n                                    <p class=\"text-[10px] font-normal text-[#A1A1AA] mt-1\" data-kid=\"273\">Detection of breaking changes across abstraction layers.</p>\n                                </td>\n                                <td class=\"p-8 text-center border-r border-[#262626] text-red-500\" data-kid=\"274\"><i class=\"ti ti-x text-xl opacity-50\" data-kid=\"275\"></i></td>\n                                <td class=\"p-8 text-center font-bold text-[#22C55E]\" data-kid=\"276\">Full-System Trace</td>\n                            </tr>\n                            <tr class=\"border-b border-[#262626] group hover:bg-white/5 transition-colors\" data-kid=\"277\">\n                                <td class=\"p-8 border-r border-[#262626] font-medium\" data-kid=\"278\">\n                                    Dependency Propagation\n                                    <p class=\"text-[10px] font-normal text-[#A1A1AA] mt-1\" data-kid=\"279\">Cross-file tracking of function signature changes.</p>\n                                </td>\n                                <td class=\"p-8 text-center border-r border-[#262626] text-red-500\" data-kid=\"280\"><i class=\"ti ti-x text-xl opacity-50\" data-kid=\"281\"></i></td>\n                                <td class=\"p-8 text-center font-bold text-[#22C55E]\" data-kid=\"282\">Proprietary Graph Analysis</td>\n                            </tr>\n                            <tr class=\"border-b border-[#262626] group hover:bg-white/5 transition-colors\" data-kid=\"283\">\n                                <td class=\"p-8 border-r border-[#262626] font-medium\" data-kid=\"284\">\n                                    Production Risk Score\n                                    <p class=\"text-[10px] font-normal text-[#A1A1AA] mt-1\" data-kid=\"285\">Real-time assessment of operational risk based on blast radius.</p>\n                                </td>\n                                <td class=\"p-8 text-center border-r border-[#262626] text-[#A1A1AA]\" data-kid=\"286\">Manual Labeling</td>\n                                <td class=\"p-8 text-center font-bold text-[#22C55E]\" data-kid=\"287\">Automated Scoring</td>\n                            </tr>\n                            <tr class=\"group hover:bg-white/5 transition-colors\" data-kid=\"288\">\n                                <td class=\"p-8 border-r border-[#262626] font-medium\" data-kid=\"289\">\n                                    Zero Code Retention\n                                    <p class=\"text-[10px] font-normal text-[#A1A1AA] mt-1\" data-kid=\"290\">Privacy guarantee for proprietary logic.</p>\n                                </td>\n                                <td class=\"p-8 text-center border-r border-[#262626] text-[#A1A1AA]\" data-kid=\"291\">Opt-out Required</td>\n                                <td class=\"p-8 text-center font-bold text-[#22C55E]\" data-kid=\"292\">Strictly Ephemeral</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 px-6 bg-[#0f0f0f]\" data-kid=\"293\">\n            <div class=\"max-w-4xl mx-auto\" data-kid=\"294\">\n                <div class=\"flex items-center justify-between mb-16\" data-kid=\"295\">\n                    <div data-kid=\"296\">\n                        <h2 class=\"text-3xl font-bold font-inter\" data-kid=\"297\">Live Risk Stream</h2>\n                        <p class=\"text-[#A1A1AA] mt-1 text-sm\" data-kid=\"298\">Example analysis output for representative production workloads.</p>\n                    </div>\n                    <div class=\"bg-[#111111] border border-[#262626] rounded-full px-4 py-1.5 flex items-center gap-2\" data-kid=\"299\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#22C55E] animate-pulse\" data-kid=\"300\"></span>\n                        <span class=\"text-xs font-mono font-bold tracking-tight text-[#FAFAFA]\" data-kid=\"301\">LIVE ANALYSIS</span>\n                    </div>\n                </div>\n\n                <div class=\"space-y-1\" data-kid=\"302\">\n                    \n                    <div class=\"bg-[#111111] border border-[#262626] p-4 flex items-center gap-6 hover:bg-[#1a1a1a] transition-all group cursor-default\" data-kid=\"303\">\n                        <div class=\"w-2 h-2 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.4)]\" data-kid=\"304\"></div>\n                        <div class=\"w-16 text-xs font-mono text-[#A1A1AA] group-hover:text-white transition-colors\" data-kid=\"305\">PR #1423</div>\n                        <div class=\"flex-1 font-bold text-sm tracking-tight truncate\" data-kid=\"306\">Refactor: Billing queue retry logic</div>\n                        <div class=\"w-32\" data-kid=\"307\">\n                            <div class=\"h-1 w-full bg-[#262626] rounded-full overflow-hidden\" data-kid=\"308\">\n                                <div class=\"h-full bg-red-500 w-[91%]\" data-kid=\"309\"></div>\n                            </div>\n                            <div class=\"text-[9px] text-red-400 mt-1 font-bold\" data-kid=\"310\">91% RISK</div>\n                        </div>\n                        <div class=\"text-xs text-[#A1A1AA] font-mono\" data-kid=\"311\">12m ago</div>\n                    </div>\n                    \n                    <div class=\"bg-[#111111] border border-[#262626] p-4 flex items-center gap-6 hover:bg-[#1a1a1a] transition-all group cursor-default\" data-kid=\"312\">\n                        <div class=\"w-2 h-2 rounded-full bg-[#22C55E]\" data-kid=\"313\"></div>\n                        <div class=\"w-16 text-xs font-mono text-[#A1A1AA] group-hover:text-white transition-colors\" data-kid=\"314\">PR #1418</div>\n                        <div class=\"flex-1 font-bold text-sm tracking-tight truncate\" data-kid=\"315\">Feature: Add read-only flag to user settings</div>\n                        <div class=\"w-32\" data-kid=\"316\">\n                            <div class=\"h-1 w-full bg-[#262626] rounded-full overflow-hidden\" data-kid=\"317\">\n                                <div class=\"h-full bg-[#22C55E] w-[12%]\" data-kid=\"318\"></div>\n                            </div>\n                            <div class=\"text-[9px] text-[#22C55E] mt-1 font-bold\" data-kid=\"319\">LOW RISK</div>\n                        </div>\n                        <div class=\"text-xs text-[#A1A1AA] font-mono\" data-kid=\"320\">48m ago</div>\n                    </div>\n                    \n                    <div class=\"bg-[#111111] border border-[#262626] p-4 flex items-center gap-6 hover:bg-[#1a1a1a] transition-all group cursor-default\" data-kid=\"321\">\n                        <div class=\"w-2 h-2 rounded-full bg-yellow-500\" data-kid=\"322\"></div>\n                        <div class=\"w-16 text-xs font-mono text-[#A1A1AA] group-hover:text-white transition-colors\" data-kid=\"323\">PR #1430</div>\n                        <div class=\"flex-1 font-bold text-sm tracking-tight truncate\" data-kid=\"324\">Fix: Database connection pool leak in telemetry</div>\n                        <div class=\"w-32\" data-kid=\"325\">\n                            <div class=\"h-1 w-full bg-[#262626] rounded-full overflow-hidden\" data-kid=\"326\">\n                                <div class=\"h-full bg-yellow-500 w-[64%]\" data-kid=\"327\"></div>\n                            </div>\n                            <div class=\"text-[9px] text-yellow-400 mt-1 font-bold\" data-kid=\"328\">MEDIUM RISK</div>\n                        </div>\n                        <div class=\"text-xs text-[#A1A1AA] font-mono\" data-kid=\"329\">2h ago</div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section id=\"security\" class=\"py-40 px-6\" data-kid=\"330\">\n            <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row gap-20\" data-kid=\"331\">\n                \n                <div class=\"w-full md:w-64 shrink-0 flex flex-col gap-10 border-r border-[#262626] pr-10\" data-kid=\"332\">\n                    <div class=\"space-y-8\" data-kid=\"333\">\n                        <div class=\"flex items-center gap-4 text-[#22C55E] border-l-2 border-[#22C55E] -ml-10 pl-9 py-1\" data-kid=\"334\">\n                            <i class=\"ti ti-shield-lock text-2xl\" data-kid=\"335\"></i>\n                            <span class=\"font-bold text-sm uppercase tracking-widest\" data-kid=\"336\">Security</span>\n                        </div>\n                        <div class=\"flex items-center gap-4 text-[#A1A1AA] hover:text-[#FAFAFA] transition-colors cursor-pointer pl-9\" data-kid=\"337\">\n                            <i class=\"ti ti-database text-2xl\" data-kid=\"338\"></i>\n                            <span class=\"font-bold text-sm uppercase tracking-widest\" data-kid=\"339\">Retention</span>\n                        </div>\n                        <div class=\"flex items-center gap-4 text-[#A1A1AA] hover:text-[#FAFAFA] transition-colors cursor-pointer pl-9\" data-kid=\"340\">\n                            <i class=\"ti ti-key text-2xl\" data-kid=\"341\"></i>\n                            <span class=\"font-bold text-sm uppercase tracking-widest\" data-kid=\"342\">Access</span>\n                        </div>\n                        <div class=\"flex items-center gap-4 text-[#A1A1AA] hover:text-[#FAFAFA] transition-colors cursor-pointer pl-9\" data-kid=\"343\">\n                            <i class=\"ti ti-server text-2xl\" data-kid=\"344\"></i>\n                            <span class=\"font-bold text-sm uppercase tracking-widest\" data-kid=\"345\">Compliance</span>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"flex-1\" data-kid=\"346\">\n                    <h2 class=\"text-4xl font-bold font-inter mb-12\" data-kid=\"347\">Built for high-trust environments.</h2>\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 mb-20\" data-kid=\"348\">\n                        <div class=\"space-y-6\" data-kid=\"349\">\n                            <h3 class=\"text-xl font-bold font-inter flex items-center gap-3\" data-kid=\"350\">\n                                <i class=\"ti ti-brand-github text-[#A1A1AA]\" data-kid=\"351\"></i>\n                                GitHub Native Analysis\n                            </h3>\n                            <p class=\"text-[#A1A1AA] leading-relaxed text-lg\" data-kid=\"352\">GrepAI operates as a strictly scoped GitHub App. We use short-lived installation tokens and never request permissions beyond those required for architectural analysis. Our access is limited to the repositories you explicitly authorize.</p>\n                        </div>\n                        <div class=\"space-y-6\" data-kid=\"353\">\n                            <h3 class=\"text-xl font-bold font-inter flex items-center gap-3\" data-kid=\"354\">\n                                <i class=\"ti ti-trash-x text-[#A1A1AA]\" data-kid=\"355\"></i>\n                                Zero Code Retention\n                            </h3>\n                            <p class=\"text-[#A1A1AA] leading-relaxed text-lg\" data-kid=\"356\">Your source code is never stored on disk. Analysis is performed in transient, memory-only execution environments that are wiped immediately after results are generated. We do not train models on customer code.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"pt-20 border-t border-[#262626] grid grid-cols-1 sm:grid-cols-3 gap-16\" data-kid=\"357\">\n                        <div data-kid=\"358\">\n                            <div class=\"text-[#A1A1AA] text-xs font-bold uppercase tracking-widest mb-3\" data-kid=\"359\">Analysis Latency</div>\n                            <div class=\"text-5xl font-bold font-inter tracking-tighter\" data-kid=\"360\">&lt;60s</div>\n                        </div>\n                        <div data-kid=\"361\">\n                            <div class=\"text-[#A1A1AA] text-xs font-bold uppercase tracking-widest mb-3\" data-kid=\"362\">Code Storage</div>\n                            <div class=\"text-5xl font-bold font-inter tracking-tighter\" data-kid=\"363\">0<span class=\"text-2xl text-[#A1A1AA] font-normal ml-1 tracking-normal\" data-kid=\"364\">bytes</span></div>\n                        </div>\n                        <div data-kid=\"365\">\n                            <div class=\"text-[#A1A1AA] text-xs font-bold uppercase tracking-widest mb-3\" data-kid=\"366\">Graph Depth</div>\n                            <div class=\"text-5xl font-bold font-inter tracking-tighter\" data-kid=\"367\">∞</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"min-h-screen flex items-end pb-32 px-6 relative overflow-hidden bg-[#0A0A0A]\" data-kid=\"368\">\n            \n            <div class=\"absolute top-1/2 right-0 w-[800px] h-[800px] bg-[#22C55E]/5 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2\" data-kid=\"369\"></div>\n            \n            <div class=\"max-w-7xl mx-auto w-full relative z-10\" data-kid=\"370\">\n                <div class=\"max-w-4xl pb-20 md:pb-0\" data-kid=\"371\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#22C55E]/10 border border-[#22C55E]/20 text-[10px] font-bold text-[#22C55E] uppercase tracking-widest mb-8\" data-kid=\"372\">\n                        Now available for GitHub Enterprise\n                    </div>\n                    <h2 class=\"text-6xl md:text-8xl font-bold font-inter mb-12 leading-[0.95] tracking-tighter\" data-kid=\"373\">\n                        Review the system,<br data-kid=\"374\">not just the diff.\n                    </h2>\n                    <p class=\"text-2xl text-[#A1A1AA] mb-12 max-w-2xl leading-relaxed\" data-kid=\"375\">\n                        Join engineering teams at high-growth platforms who use GrepAI to catch regressions before they hit production.\n                    </p>\n                    <div class=\"flex flex-col sm:flex-row gap-6\" data-kid=\"376\">\n                        <button class=\"bg-[#22C55E] text-[#0A0A0A] px-10 py-5 rounded text-xl font-bold font-inter flex items-center gap-3 cursor-pointer\" data-kid=\"377\">\n                            Connect Repository\n                            <i class=\"ti ti-arrow-right\" data-kid=\"378\"></i>\n                        </button>\n                        <button class=\"bg-white/10 text-white px-10 py-5 rounded text-xl font-bold font-inter hover:bg-white/15 transition-colors flex items-center gap-3 cursor-pointer\" data-kid=\"379\">\n                            View Docs\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <footer class=\"py-20 px-6 border-t border-[#262626] bg-[#0A0A0A]\" data-kid=\"380\">\n            <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12\" data-kid=\"381\">\n                <div class=\"space-y-6\" data-kid=\"382\">\n                    <a href=\"/\" class=\"text-2xl font-bold font-inter tracking-tighter flex items-center gap-2\" data-kid=\"383\">\n                        <i class=\"ti ti-binary text-[#22C55E]\" data-kid=\"384\"></i>\n                        GREPAI\n                    </a>\n                    <p class=\"text-[#A1A1AA] max-w-xs text-sm\" data-kid=\"385\">Repository-aware PR risk analysis for teams that care about production stability.</p>\n                </div>\n                <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-20\" data-kid=\"386\">\n                    <div class=\"space-y-4\" data-kid=\"387\">\n                        <h4 class=\"text-xs font-bold uppercase tracking-widest text-[#FAFAFA]\" data-kid=\"388\">Product</h4>\n                        <ul class=\"space-y-3 text-sm text-[#A1A1AA]\" data-kid=\"389\">\n                            <li data-kid=\"390\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"391\">How it works</a></li>\n                            <li data-kid=\"392\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"393\">Pricing</a></li>\n                            <li data-kid=\"394\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"395\">Security</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-4\" data-kid=\"396\">\n                        <h4 class=\"text-xs font-bold uppercase tracking-widest text-[#FAFAFA]\" data-kid=\"397\">Resources</h4>\n                        <ul class=\"space-y-3 text-sm text-[#A1A1AA]\" data-kid=\"398\">\n                            <li data-kid=\"399\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"400\">Documentation</a></li>\n                            <li data-kid=\"401\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"402\">API Reference</a></li>\n                            <li data-kid=\"403\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"404\">Change Log</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-4\" data-kid=\"405\">\n                        <h4 class=\"text-xs font-bold uppercase tracking-widest text-[#FAFAFA]\" data-kid=\"406\">Company</h4>\n                        <ul class=\"space-y-3 text-sm text-[#A1A1AA]\" data-kid=\"407\">\n                            <li data-kid=\"408\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"409\">About</a></li>\n                            <li data-kid=\"410\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"411\">Twitter</a></li>\n                            <li data-kid=\"412\"><a href=\"#\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"413\">GitHub</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"max-w-7xl mx-auto mt-20 pt-10 border-t border-[#262626] flex justify-between items-center text-[10px] font-mono text-[#A1A1AA] uppercase tracking-widest\" data-kid=\"414\">\n                <span data-kid=\"415\">© 2024 GREPAI INC.</span>\n                <div class=\"flex gap-8\" data-kid=\"416\">\n                    <a href=\"#\" data-kid=\"417\">Privacy</a>\n                    <a href=\"#\" data-kid=\"418\">Terms</a>\n                    <a href=\"#\" data-kid=\"419\">Security</a>\n                </div>\n            </div>\n        </footer>\n    </div>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"420\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"421\"></script>\n<script type=\"module\" data-kid=\"422\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    import { animate, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    // Lenis Smooth Scroll\n    const lenis = new Lenis({\n        autoRaf: true,\n        lerp: 0.1,\n        smoothWheel: true\n    });\n\n    // GSAP ScrollTrigger Registry\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Synchronize Lenis with ScrollTrigger\n    lenis.on('scroll', ScrollTrigger.update);\n\n    // Workflow Steps Animation\n    const steps = document.querySelectorAll('.workflow-step');\n    steps.forEach((step, i) => {\n        gsap.from(step, {\n            opacity: 0,\n            y: 50,\n            duration: 1,\n            scrollTrigger: {\n                trigger: step,\n                start: \"top 80%\",\n                toggleActions: \"play none none reverse\"\n            }\n        });\n    });\n\n    // Entrance animations for sections\n    inView(\"section\", (info) => {\n        animate(info.target, { opacity: [0, 1], y: [40, 0] }, { duration: 1, easing: [0.22, 1, 0.36, 1] });\n    });\n\n    // Hover interactions using Motion\n    const navButtons = document.querySelectorAll('button');\n    navButtons.forEach(btn => {\n        btn.addEventListener('mouseenter', () => {\n            animate(btn, { scale: 1.05 }, { type: \"spring\", stiffness: 400, damping: 10 });\n        });\n        btn.addEventListener('mouseleave', () => {\n            animate(btn, { scale: 1 }, { type: \"spring\", stiffness: 400, damping: 10 });\n        });\n    });\n\n</script>\n",
