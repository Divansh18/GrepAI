      "html": "\n<div class=\"bg-[#0A0A0A] text-[#FAFAFA] font-['IBM_Plex_Sans'] selection:bg-[#22C55E]/30 overflow-x-clip\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n        \n        :root {\n            --bg: #0A0A0A;\n            --panel: #141414;\n            --panel-light: #1c1c1c;\n            --border: #2a2a2a;\n            --accent: #22C55E;\n            --accent-blue: #3B82F6;\n            --accent-orange: #F97316;\n            --muted: #A1A1AA;\n        }\n\n        .font-header { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .font-mono { font-family: 'IBM Plex Mono', monospace; }\n\n        /* Custom scrollbar */\n        ::-webkit-scrollbar { width: 6px; }\n        ::-webkit-scrollbar-track { background: var(--bg); }\n        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }\n        ::-webkit-scrollbar-thumb:hover { background: #333; }\n\n        .bento-grid {\n            display: grid;\n            grid-template-columns: repeat(12, 1fr);\n            gap: 1.5rem;\n        }\n\n        .glass-panel {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-top: 1px solid rgba(255,255,255,0.05);\n            border-radius: 6px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.5);\n        }\n\n        .monitoring-grid {\n            background-image: radial-gradient(circle, #1a1a1a 1px, transparent 1px);\n            background-size: 32px 32px;\n        }\n\n        .globe-circle {\n            border: 1px solid rgba(161, 161, 170, 0.08);\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n        }\n\n        .timeline-spine {\n            position: absolute;\n            left: 50%;\n            top: 0;\n            bottom: 0;\n            width: 1px;\n            background: linear-gradient(to bottom, transparent, var(--border) 10%, var(--border) 90%, transparent);\n            transform: translateX(-50%);\n        }\n\n        .risk-card {\n            touch-action: none;\n            cursor: grab;\n            background: #1c1c1c;\n            border: 1px solid #333;\n            transition: border-color 0.3s ease, box-shadow 0.3s ease;\n        }\n        .risk-card:hover { border-color: rgba(255,255,255,0.2); }\n        .risk-card[data-risk=\"high\"]:hover { box-shadow: 0 0 30px rgba(239, 68, 68, 0.1); border-color: #EF4444; }\n        .risk-card[data-risk=\"low\"]:hover { box-shadow: 0 0 30px rgba(34, 197, 94, 0.1); border-color: #22C55E; }\n        .risk-card[data-risk=\"med\"]:hover { box-shadow: 0 0 30px rgba(249, 115, 22, 0.1); border-color: #F97316; }\n        .risk-card:active { cursor: grabbing; }\n\n        /* Oversized text behind */\n        .text-behind-bg {\n            font-size: min(15vw, 240px);\n            line-height: 0.8;\n            font-weight: 800;\n            color: #121212;\n            letter-spacing: -0.05em;\n            pointer-events: none;\n            user-select: none;\n            white-space: nowrap;\n        }\n\n        .node-pulse {\n            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n        }\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: .5; transform: scale(1.2); }\n        }\n    </style>\n\n    \n    <nav class=\"sticky top-0 z-50 bg-[#0A0A0A]/90 backdrop-blur-xl border-b border-white/5\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-10\" data-kid=\"4\">\n                <a href=\"/\" class=\"font-header text-xl font-extrabold tracking-tighter flex items-center gap-2\" data-kid=\"5\">\n                    <div class=\"w-6 h-6 bg-[#22C55E] rounded-xs flex items-center justify-center\" data-kid=\"6\">\n                        <div class=\"w-2 h-2 bg-black rounded-full\" data-kid=\"7\"></div>\n                    </div>\n                    <span data-kid=\"8\">GREPAI</span>\n                </a>\n                <div class=\"hidden md:flex gap-8 text-sm font-medium text-[#A1A1AA]\" data-kid=\"9\">\n                    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"10\">Product</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Architecture</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Security</a>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-8 text-sm font-medium\" data-kid=\"13\">\n                <div class=\"hidden lg:flex gap-6\" data-kid=\"14\">\n                    <a href=\"#\" class=\"text-[#A1A1AA] hover:text-white transition-colors\" data-kid=\"15\">Docs</a>\n                    <a href=\"#\" class=\"text-[#A1A1AA] hover:text-white transition-colors\" data-kid=\"16\">GitHub</a>\n                </div>\n                <button class=\"border border-[#22C55E] text-[#22C55E] px-5 py-2 rounded-xs hover:bg-[#22C55E]/10 transition-colors font-bold tracking-tight\" data-kid=\"17\">Connect Repository</button>\n            </div>\n        </div>\n    </nav>\n\n    <main data-scroll-container data-kid=\"18\">\n        \n        <section class=\"py-12 px-6 max-w-7xl mx-auto\" id=\"hero\" data-kid=\"19\">\n            <div class=\"bento-grid\" data-kid=\"20\">\n                \n                <div class=\"col-span-12 lg:col-span-8 glass-panel p-12 flex flex-col justify-center relative overflow-hidden\" data-kid=\"21\">\n                    <div class=\"relative z-10\" data-kid=\"22\">\n                        <div class=\"inline-flex items-center gap-2 bg-[#22C55E]/10 border border-[#22C55E]/20 px-3 py-1 rounded-full mb-8\" data-kid=\"23\">\n                            <span class=\"relative flex h-2 w-2\" data-kid=\"24\">\n                                <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22C55E] opacity-75\" data-kid=\"25\"></span>\n                                <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[#22C55E]\" data-kid=\"26\"></span>\n                            </span>\n                            <span class=\"text-[10px] font-mono font-bold text-[#22C55E] uppercase tracking-widest\" data-kid=\"27\">v4.0 Live Analysis Engine</span>\n                        </div>\n                        <h1 class=\"font-header text-6xl font-bold leading-[1.1] mb-8 tracking-tight\" data-kid=\"28\">\n                            Repository-aware<br data-kid=\"29\"><span class=\"text-[#22C55E]\" data-kid=\"30\">PR risk analysis.</span>\n                        </h1>\n                        <p class=\"text-[#A1A1AA] text-xl max-w-xl mb-12 leading-relaxed\" data-kid=\"31\">\n                            Understand the blast radius of a change before it reaches production. Identify architectural side effects that traditional linters miss.\n                        </p>\n                        <div class=\"flex flex-wrap gap-4\" data-kid=\"32\">\n                            <button class=\"bg-[#22C55E] text-black font-bold px-10 py-4 rounded-xs hover:bg-[#1eb054] transition-all transform hover:-translate-y-1 shadow-lg shadow-[#22C55E]/20\" data-kid=\"33\">Connect Repository</button>\n                            <button class=\"border border-[#262626] text-white font-bold px-10 py-4 rounded-xs hover:bg-[#1a1a1a] transition-all\" data-kid=\"34\">View Demo Analysis</button>\n                        </div>\n                    </div>\n                    \n                    <div class=\"absolute -right-20 -bottom-20 w-96 h-96 bg-[#22C55E]/5 blur-[120px] rounded-full\" data-kid=\"35\"></div>\n                </div>\n\n                \n                <div class=\"col-span-12 lg:col-span-4 glass-panel p-8 relative overflow-hidden flex flex-col justify-between\" data-kid=\"36\">\n                    <div class=\"flex items-center justify-between mb-8\" data-kid=\"37\">\n                        <span class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-widest\" data-kid=\"38\">Blast_Radius_Monitor</span>\n                        <div class=\"px-2 py-0.5 border border-red-500/30 bg-red-500/10 text-red-500 text-[10px] font-mono font-bold rounded uppercase\" data-kid=\"39\">Active Risk</div>\n                    </div>\n                    \n                    <div class=\"relative h-64 flex items-center justify-center\" id=\"network-hero\" data-kid=\"40\">\n                        \n                        <div class=\"absolute w-4 h-4 bg-red-500 rounded-full node-pulse z-20\" data-kid=\"41\"></div>\n                        <div class=\"absolute w-12 h-12 border border-red-500/20 rounded-full animate-ping\" data-kid=\"42\"></div>\n                        \n                        <div class=\"absolute border border-[#262626] rounded-full w-40 h-40 animate-[spin_20s_linear_infinite]\" data-kid=\"43\">\n                            <div class=\"absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-[#3F3F46] rounded-full border border-black\" data-kid=\"44\"></div>\n                        </div>\n                        <div class=\"absolute border border-[#262626] rounded-full w-56 h-56 animate-[spin_30s_linear_infinite_reverse]\" data-kid=\"45\">\n                            <div class=\"absolute top-1/2 -left-1.5 -translate-y-1/2 w-3 h-3 bg-[#3F3F46] rounded-full border border-black\" data-kid=\"46\"></div>\n                        </div>\n                        \n                        \n                        <svg class=\"absolute inset-0 w-full h-full opacity-30\" data-kid=\"47\">\n                            <line x1=\"50%\" y1=\"50%\" x2=\"70%\" y2=\"30%\" stroke=\"#262626\" stroke-width=\"1\" data-kid=\"48\"></line>\n                            <line x1=\"50%\" y1=\"50%\" x2=\"30%\" y2=\"40%\" stroke=\"#262626\" stroke-width=\"1\" data-kid=\"49\"></line>\n                            <line x1=\"50%\" y1=\"50%\" x2=\"60%\" y2=\"70%\" stroke=\"#262626\" stroke-width=\"1\" data-kid=\"50\"></line>\n                        </svg>\n\n                        \n                        <div id=\"hero-ripples\" class=\"absolute inset-0 pointer-events-none\" data-kid=\"51\"></div>\n                    </div>\n\n                    <div class=\"mt-8 space-y-4\" data-kid=\"52\">\n                        <div class=\"flex justify-between items-center text-[11px] font-mono text-[#A1A1AA]\" data-kid=\"53\">\n                            <span data-kid=\"54\">DEPENDENCY DEPTH</span>\n                            <span class=\"text-white\" data-kid=\"55\">LEVEL 4</span>\n                        </div>\n                        <div class=\"h-1 bg-[#1a1a1a] rounded-full overflow-hidden\" data-kid=\"56\">\n                            <div class=\"h-full bg-red-500 w-3/4\" data-kid=\"57\"></div>\n                        </div>\n                        <p class=\"text-[10px] text-[#A1A1AA] leading-relaxed\" data-kid=\"58\">\n                            Detecting circular propagation in <span class=\"text-white\" data-kid=\"59\">payment-microservice</span>...\n                        </p>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-12 glass-panel p-8\" data-kid=\"60\">\n                    <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 border-b border-[#262626] pb-6\" data-kid=\"61\">\n                        <div class=\"flex items-center gap-6 font-mono text-sm\" data-kid=\"62\">\n                            <span class=\"text-white font-bold\" data-kid=\"63\">PR #842</span>\n                            <span class=\"text-[#262626]\" data-kid=\"64\">|</span>\n                            <span class=\"text-[#A1A1AA]\" data-kid=\"65\">Refactor Auth Middleware</span>\n                            <span class=\"text-[#262626]\" data-kid=\"66\">|</span>\n                            <span class=\"text-red-500 font-bold\" data-kid=\"67\">RISK: CRITICAL</span>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"68\">\n                            <div class=\"text-right\" data-kid=\"69\">\n                                <div class=\"text-[10px] font-mono text-[#A1A1AA] uppercase\" data-kid=\"70\">Analysis Speed</div>\n                                <div class=\"text-sm font-bold text-[#22C55E]\" data-kid=\"71\">18.4 seconds</div>\n                            </div>\n                            <div class=\"w-px h-8 bg-[#262626]\" data-kid=\"72\"></div>\n                            <div class=\"text-right\" data-kid=\"73\">\n                                <div class=\"text-[10px] font-mono text-[#A1A1AA] uppercase\" data-kid=\"74\">Confidence</div>\n                                <div class=\"text-sm font-bold text-white\" data-kid=\"75\">96.8%</div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\" data-kid=\"76\">\n                        <div class=\"space-y-4\" data-kid=\"77\">\n                            <h4 class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-widest border-l-2 border-[#22C55E] pl-3\" data-kid=\"78\">Impacted Services</h4>\n                            <div class=\"space-y-3\" data-kid=\"79\">\n                                <div class=\"flex items-center justify-between group\" data-kid=\"80\">\n                                    <span class=\"text-sm text-[#D4D4D8]\" data-kid=\"81\">Auth-Service</span>\n                                    <span class=\"text-[10px] font-mono text-red-400 bg-red-400/10 px-1.5 py-0.5 rounded\" data-kid=\"82\">DIRECT</span>\n                                </div>\n                                <div class=\"flex items-center justify-between\" data-kid=\"83\">\n                                    <span class=\"text-sm text-[#D4D4D8]\" data-kid=\"84\">Billing-Proxy</span>\n                                    <span class=\"text-[10px] font-mono text-orange-400 bg-orange-400/10 px-1.5 py-0.5 rounded\" data-kid=\"85\">INDIRECT</span>\n                                </div>\n                                <div class=\"flex items-center justify-between\" data-kid=\"86\">\n                                    <span class=\"text-sm text-[#D4D4D8]\" data-kid=\"87\">Session-Vault</span>\n                                    <span class=\"text-[10px] font-mono text-orange-400 bg-orange-400/10 px-1.5 py-0.5 rounded\" data-kid=\"88\">INDIRECT</span>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"lg:col-span-2 space-y-6\" data-kid=\"89\">\n                            <h4 class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-widest border-l-2 border-[#A1A1AA] pl-3\" data-kid=\"90\">Risk Assessment</h4>\n                            <div class=\"space-y-5\" data-kid=\"91\">\n                                <div class=\"space-y-2\" data-kid=\"92\">\n                                    <div class=\"flex justify-between text-[11px] font-mono\" data-kid=\"93\">\n                                        <span class=\"text-[#A1A1AA]\" data-kid=\"94\">Architectural Invariant Breach</span>\n                                        <span class=\"text-white\" data-kid=\"95\">92%</span>\n                                    </div>\n                                    <div class=\"h-1.5 bg-[#1a1a1a] rounded-full overflow-hidden\" data-kid=\"96\">\n                                        <div class=\"h-full bg-red-500 w-[92%] rounded-full shadow-[0_0_8px_rgba(239,68,68,0.3)]\" data-kid=\"97\"></div>\n                                    </div>\n                                </div>\n                                <div class=\"space-y-2\" data-kid=\"98\">\n                                    <div class=\"flex justify-between text-[11px] font-mono\" data-kid=\"99\">\n                                        <span class=\"text-[#A1A1AA]\" data-kid=\"100\">Downstream Side Effects</span>\n                                        <span class=\"text-white\" data-kid=\"101\">68%</span>\n                                    </div>\n                                    <div class=\"h-1.5 bg-[#1a1a1a] rounded-full overflow-hidden\" data-kid=\"102\">\n                                        <div class=\"h-full bg-orange-500 w-[68%] rounded-full shadow-[0_0_8px_rgba(249,115,22,0.3)]\" data-kid=\"103\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"bg-[#1a1a1a]/50 p-6 border border-[#262626] rounded-xs\" data-kid=\"104\">\n                            <h4 class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-widest mb-4\" data-kid=\"105\">Recommendation</h4>\n                            <p class=\"text-xs text-[#D4D4D8] leading-relaxed mb-4\" data-kid=\"106\">\n                                \"The change in <code class=\"text-white\" data-kid=\"107\">auth.go:142</code> bypasses the MFA state check for recurring payments. Manual audit of billing-proxy is required.\"\n                            </p>\n                            <div class=\"flex items-center gap-2 text-[10px] font-mono text-red-500\" data-kid=\"108\">\n                                <div class=\"w-2 h-2 rounded-full bg-red-500 animate-pulse\" data-kid=\"109\"></div>\n                                BLOCK MERGE RECOMMENDED\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-24 px-6 overflow-hidden monitoring-grid\" id=\"workflow\" data-kid=\"110\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"111\">\n                <div class=\"text-center mb-16\" data-kid=\"112\">\n                    <h2 class=\"font-header text-4xl font-bold mb-4\" data-kid=\"113\">Analysis Pipeline</h2>\n                    <p class=\"text-[#A1A1AA] text-lg max-w-2xl mx-auto\" data-kid=\"114\">Automated discovery of side-effects within your existing CI/CD.</p>\n                </div>\n\n                <div class=\"relative workflow-container max-w-5xl mx-auto\" data-kid=\"115\">\n                    <div class=\"timeline-spine\" data-kid=\"116\"></div>\n                    \n                    \n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-24 mb-24 items-center relative z-10 workflow-step\" data-kid=\"117\">\n                        <div class=\"md:text-right\" data-kid=\"118\">\n                            <div class=\"text-[#22C55E] font-mono text-xs mb-3 uppercase tracking-[0.2em] font-bold\" data-kid=\"119\">01. Hook</div>\n                            <h3 class=\"text-2xl font-header font-bold mb-4\" data-kid=\"120\">Native GitHub Webhook</h3>\n                            <p class=\"text-[#A1A1AA] text-sm leading-relaxed ml-auto max-w-xs\" data-kid=\"121\">\n                                GrepAI triggers on PR synchronization. Ephemeral gVisor sandboxes are spun up for secure repository analysis.\n                            </p>\n                        </div>\n                        <div class=\"glass-panel p-5 font-mono text-[11px] leading-relaxed text-[#A1A1AA] group border-l-2 border-l-[#22C55E]\" data-kid=\"122\">\n                            <pre data-kid=\"123\"><code class=\"text-[#D4D4D8]\">{\n  \"event\": \"pull_request\",\n  \"action\": \"synchronized\",\n  \"repository\": \"grep-ai/core-engine\",\n  \"trigger\": \"ephemeral-sandbox-v4\"\n}</code></pre>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-24 mb-24 items-center relative z-10 workflow-step\" data-kid=\"124\">\n                        <div class=\"order-2 md:order-1 glass-panel p-5 font-mono text-[11px] leading-relaxed text-[#A1A1AA] group border-r-2 border-r-[#3B82F6]\" data-kid=\"125\">\n                            <pre data-kid=\"126\"><code class=\"text-[#D4D4D8]\">{\n  \"engine\": \"v4-node-walker\",\n  \"scanned_files\": 1420,\n  \"affected_nodes\": [\n    \"auth/middleware.go\",\n    \"billing/gateway.go\"\n  ],\n  \"depth\": 5\n}</code></pre>\n                        </div>\n                        <div class=\"order-1 md:order-2 text-left\" data-kid=\"127\">\n                            <div class=\"text-[#3B82F6] font-mono text-xs mb-3 uppercase tracking-[0.2em] font-bold\" data-kid=\"128\">02. Index</div>\n                            <h3 class=\"text-2xl font-header font-bold mb-4\" data-kid=\"129\">Dependency Propagation</h3>\n                            <p class=\"text-[#A1A1AA] text-sm leading-relaxed max-w-xs\" data-kid=\"130\">\n                                We walk the entire call graph, identifying how a diff in one file triggers failures in downstream systems.\n                            </p>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-24 items-center relative z-10 workflow-step\" data-kid=\"131\">\n                        <div class=\"md:text-right\" data-kid=\"132\">\n                            <div class=\"text-[#EF4444] font-mono text-xs mb-3 uppercase tracking-[0.2em] font-bold\" data-kid=\"133\">03. Report</div>\n                            <h3 class=\"text-2xl font-header font-bold mb-4\" data-kid=\"134\">Risk Intelligence</h3>\n                            <p class=\"text-[#A1A1AA] text-sm leading-relaxed ml-auto max-w-xs\" data-kid=\"135\">\n                                Actionable findings delivered via API and GitHub comments, pointing to the exact line of architectural risk.\n                            </p>\n                        </div>\n                        <div class=\"glass-panel p-5 font-mono text-[11px] leading-relaxed text-[#A1A1AA] border-l-2 border-l-[#EF4444]\" data-kid=\"136\">\n                            <pre data-kid=\"137\"><code class=\"text-[#D4D4D8]\">{\n  \"risk_score\": 0.94,\n  \"finding\": \"ARCH-042: Bypass\",\n  \"status\": \"BLOCK_MERGE\"\n}</code></pre>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-24 px-6 bg-[#0A0A0A]\" id=\"globe-section\" data-kid=\"138\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"139\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-5 gap-16 items-center\" data-kid=\"140\">\n                    <div class=\"lg:col-span-2\" data-kid=\"141\">\n                        <h2 class=\"font-header text-4xl font-bold mb-8 leading-tight\" data-kid=\"142\">System-Wide Awareness</h2>\n                        <p class=\"text-[#A1A1AA] text-lg mb-10 leading-relaxed\" data-kid=\"143\">\n                            GrepAI visualizes the entire web of interconnected services, highlighting how a small change propagates through your architecture.\n                        </p>\n                        <div class=\"space-y-6\" data-kid=\"144\">\n                            <div class=\"flex gap-4 group\" data-kid=\"145\">\n                                <div class=\"w-12 h-12 glass-panel flex items-center justify-center shrink-0 group-hover:border-[#3B82F6]/50 transition-colors\" data-kid=\"146\">\n                                    <i class=\"lucide-git-branch text-[#3B82F6]\" data-kid=\"147\"></i>\n                                </div>\n                                <div data-kid=\"148\">\n                                    <h4 class=\"font-bold mb-1\" data-kid=\"149\">Impact Graph</h4>\n                                    <p class=\"text-sm text-[#A1A1AA]\" data-kid=\"150\">Visual map of all downstream affected modules.</p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-4 group\" data-kid=\"151\">\n                                <div class=\"w-12 h-12 glass-panel flex items-center justify-center shrink-0 group-hover:border-[#F97316]/50 transition-colors\" data-kid=\"152\">\n                                    <i class=\"lucide-shield text-[#F97316]\" data-kid=\"153\"></i>\n                                </div>\n                                <div data-kid=\"154\">\n                                    <h4 class=\"font-bold mb-1\" data-kid=\"155\">Architectural Guardrails</h4>\n                                    <p class=\"text-sm text-[#A1A1AA]\" data-kid=\"156\">Automated checks for architectural invariants.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"lg:col-span-3 relative h-[500px] glass-panel bg-black overflow-hidden flex items-center justify-center\" id=\"globe-network\" data-kid=\"157\">\n                        \n                        <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-scroll data-scroll-speed=\"-0.1\" data-kid=\"158\">\n                            <div class=\"globe-circle w-[400px] h-[400px]\" data-kid=\"159\"></div>\n                            <div class=\"globe-circle w-[400px] h-[400px] rotate-x-45 opacity-50\" data-kid=\"160\"></div>\n                            <div class=\"globe-circle w-[400px] h-[400px] rotate-y-45 opacity-50\" data-kid=\"161\"></div>\n                        </div>\n                        \n                        \n                        <div class=\"absolute inset-0\" data-scroll data-scroll-speed=\"0.2\" data-kid=\"162\">\n                            \n                            <svg class=\"absolute inset-0 w-full h-full opacity-60\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" data-kid=\"163\">\n                                <path d=\"M 20 50 Q 50 20 80 50\" stroke=\"#3B82F6\" stroke-width=\"0.2\" fill=\"none\" stroke-dasharray=\"2 1\" data-kid=\"164\"></path>\n                                <path d=\"M 20 50 Q 40 80 70 70\" stroke=\"#EF4444\" stroke-width=\"0.4\" fill=\"none\" data-kid=\"165\"></path>\n                            </svg>\n\n                            \n                            <div class=\"absolute top-[50%] left-[20%] w-3 h-3 bg-[#3B82F6] rounded-full shadow-[0_0_15px_#3B82F6] node-pulse\" data-kid=\"166\"></div>\n                            <div class=\"absolute top-[70%] left-[70%] w-5 h-5 bg-[#EF4444] rounded-full shadow-[0_0_20px_#EF4444] node-pulse\" data-kid=\"167\"></div>\n                        </div>\n\n                        \n                        <div class=\"absolute bottom-6 left-6 space-y-2 glass-panel p-3 bg-black/60 backdrop-blur-md border-white/5\" data-kid=\"168\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"169\">\n                                <div class=\"w-1.5 h-1.5 bg-[#3B82F6] rounded-full\" data-kid=\"170\"></div>\n                                <span class=\"text-[9px] font-mono text-[#A1A1AA] uppercase tracking-widest\" data-kid=\"171\">Service Cluster A</span>\n                            </div>\n                            <div class=\"flex items-center gap-2\" data-kid=\"172\">\n                                <div class=\"w-1.5 h-1.5 bg-[#EF4444] rounded-full\" data-kid=\"173\"></div>\n                                <span class=\"text-[9px] font-mono text-[#A1A1AA] uppercase tracking-widest\" data-kid=\"174\">Infected Path</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 px-6\" data-kid=\"175\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"176\">\n                <div class=\"text-center mb-20\" data-kid=\"177\">\n                    <h2 class=\"font-header text-4xl font-bold mb-4 tracking-tight\" data-kid=\"178\">Review the system, not just the diff.</h2>\n                    <p class=\"text-[#A1A1AA] text-lg max-w-xl mx-auto\" data-kid=\"179\">Traditional AI reviews naming and syntax. GrepAI reviews architectural integrity.</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-px bg-[#262626] border border-[#262626] rounded-xs overflow-hidden\" data-kid=\"180\">\n                    \n                    <div class=\"bg-[#111111] p-16 relative overflow-hidden group\" data-kid=\"181\">\n                        <div class=\"relative z-10\" data-kid=\"182\">\n                            <span class=\"text-[10px] font-mono text-red-400 mb-4 block uppercase tracking-widest\" data-kid=\"183\">Traditional AI Review</span>\n                            <h3 class=\"text-2xl font-header font-bold mb-8\" data-kid=\"184\">Narrow Context</h3>\n                            <div class=\"bg-[#0A0A0A] p-6 border border-[#262626] rounded font-mono text-sm space-y-2 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"185\">\n                                <div class=\"text-red-400/80\" data-kid=\"186\">- if (user.isAuthenticated) {</div>\n                                <div class=\"text-green-400\" data-kid=\"187\">+ if (user.isValidated) {</div>\n                            </div>\n                            <p class=\"mt-10 text-sm text-[#A1A1AA] leading-relaxed italic\" data-kid=\"188\">\n                                \"Variable renamed for clarity. LGTM.\"\n                            </p>\n                        </div>\n                        <div class=\"absolute top-0 left-0 w-1 h-full bg-red-500/20\" data-kid=\"189\"></div>\n                    </div>\n\n                    \n                    <div class=\"bg-[#111111] p-16 relative overflow-hidden group\" data-kid=\"190\">\n                        <div class=\"relative z-10\" data-kid=\"191\">\n                            <span class=\"text-[10px] font-mono text-[#22C55E] mb-4 block uppercase tracking-widest\" data-kid=\"192\">GrepAI Intelligence</span>\n                            <h3 class=\"text-2xl font-header font-bold mb-8\" data-kid=\"193\">System Context</h3>\n                            <div class=\"space-y-6\" data-kid=\"194\">\n                                <div class=\"flex items-start gap-4\" data-kid=\"195\">\n                                    <div class=\"w-1 h-12 bg-red-500 shrink-0\" data-kid=\"196\"></div>\n                                    <div data-kid=\"197\">\n                                        <div class=\"text-[10px] font-mono text-red-500 uppercase tracking-widest mb-1\" data-kid=\"198\">Architectural Breach</div>\n                                        <div class=\"text-sm text-[#FAFAFA]\" data-kid=\"199\">isValidated bypasses MFA requirements in PaymentGateway.java:42</div>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-start gap-4\" data-kid=\"200\">\n                                    <div class=\"w-1 h-12 bg-orange-500 shrink-0\" data-kid=\"201\"></div>\n                                    <div data-kid=\"202\">\n                                        <div class=\"text-[10px] font-mono text-orange-500 uppercase tracking-widest mb-1\" data-kid=\"203\">Dependency Inconsistency</div>\n                                        <div class=\"text-sm text-[#FAFAFA]\" data-kid=\"204\">SessionVault:82 still expects 'isAuthenticated' boolean</div>\n                                    </div>\n                                </div>\n                            </div>\n                            <p class=\"mt-10 text-sm text-[#22C55E] font-bold leading-relaxed\" data-kid=\"205\">\n                                \"BLOCKING: Architectural risk detected in payment flow.\"\n                            </p>\n                        </div>\n                        <div class=\"absolute top-0 left-0 w-1 h-full bg-[#22C55E]/50\" data-kid=\"206\"></div>\n                        <div class=\"absolute -right-20 -top-20 w-64 h-64 bg-[#22C55E]/5 blur-[80px] rounded-full\" data-kid=\"207\"></div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-24 px-6 relative overflow-hidden bg-[#0A0A0A] min-h-[700px]\" id=\"reports\" data-kid=\"208\">\n            <div class=\"max-w-7xl mx-auto relative h-[600px]\" data-kid=\"209\">\n                <div class=\"mb-12\" data-kid=\"210\">\n                    <h2 class=\"font-header text-4xl font-bold mb-4 tracking-tight\" data-kid=\"211\">Monitoring Findings</h2>\n                    <p class=\"text-[#A1A1AA] text-lg max-w-xl\" data-kid=\"212\">Live architectural audit logs. Drag to inspect incident depth.</p>\n                </div>\n\n                \n                <div class=\"absolute inset-x-0 bottom-0 h-48 opacity-5 pointer-events-none\" data-kid=\"213\">\n                    <svg class=\"w-full h-full\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" data-kid=\"214\">\n                        <path d=\"M 0 100 L 10 80 L 20 90 L 30 40 L 40 70 L 50 60 L 60 80 L 70 20 L 80 50 L 90 60 L 100 100\" fill=\"none\" stroke=\"white\" stroke-width=\"0.5\" data-kid=\"215\"></path>\n                    </svg>\n                </div>\n\n                \n                <div class=\"absolute inset-0 pt-40 reports-board overflow-clip\" data-kid=\"216\">\n                    \n                    <div class=\"risk-card absolute left-[5%] top-[10%] w-72 p-5 shadow-2xl z-10 select-none\" data-risk=\"high\" data-kid=\"217\">\n                        <div class=\"flex justify-between items-center mb-4\" data-kid=\"218\">\n                            <span class=\"text-[9px] font-mono text-[#A1A1AA]\" data-kid=\"219\">INCIDENT_042</span>\n                            <span class=\"text-[9px] font-mono text-red-500 bg-red-500/10 px-1.5 py-0.5 rounded border border-red-500/20 uppercase font-bold\" data-kid=\"220\">Risk: High</span>\n                        </div>\n                        <h4 class=\"font-bold text-sm mb-2\" data-kid=\"221\">Cache Loop</h4>\n                        <p class=\"text-[11px] text-[#A1A1AA] leading-relaxed mb-4\" data-kid=\"222\">Circular dependency in Redis/Auth proxy.</p>\n                        <div class=\"flex items-center gap-2 text-[9px] font-mono text-[#3B82F6]\" data-kid=\"223\">\n                            <i class=\"lucide-target size-3\" data-kid=\"224\"></i> 91% CONFIDENCE\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"risk-card absolute left-[35%] top-[5%] w-72 p-5 shadow-2xl z-20 select-none\" data-risk=\"low\" data-kid=\"225\">\n                        <div class=\"flex justify-between items-center mb-4\" data-kid=\"226\">\n                            <span class=\"text-[9px] font-mono text-[#A1A1AA]\" data-kid=\"227\">INCIDENT_038</span>\n                            <span class=\"text-[9px] font-mono text-green-500 bg-green-500/10 px-1.5 py-0.5 rounded border border-green-500/20 uppercase font-bold\" data-kid=\"228\">Risk: Low</span>\n                        </div>\n                        <h4 class=\"font-bold text-sm mb-2\" data-kid=\"229\">Schema Align</h4>\n                        <p class=\"text-[11px] text-[#A1A1AA] leading-relaxed mb-4\" data-kid=\"230\">Migrations match ORM entities perfectly.</p>\n                        <div class=\"flex items-center gap-2 text-[9px] font-mono text-[#22C55E]\" data-kid=\"231\">\n                            <i class=\"lucide-check size-3\" data-kid=\"232\"></i> 96% CONFIDENCE\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"risk-card absolute left-[65%] top-[15%] w-72 p-5 shadow-2xl z-10 select-none\" data-risk=\"med\" data-kid=\"233\">\n                        <div class=\"flex justify-between items-center mb-4\" data-kid=\"234\">\n                            <span class=\"text-[9px] font-mono text-[#A1A1AA]\" data-kid=\"235\">INCIDENT_051</span>\n                            <span class=\"text-[9px] font-mono text-orange-500 bg-orange-500/10 px-1.5 py-0.5 rounded border border-orange-500/20 uppercase font-bold\" data-kid=\"236\">Risk: Med</span>\n                        </div>\n                        <h4 class=\"font-bold text-sm mb-2\" data-kid=\"237\">Token Drift</h4>\n                        <p class=\"text-[11px] text-[#A1A1AA] leading-relaxed mb-4\" data-kid=\"238\">JWT lifetime modified. Cache drift possible.</p>\n                        <div class=\"flex items-center gap-2 text-[9px] font-mono text-[#F97316]\" data-kid=\"239\">\n                            <i class=\"lucide-alert-triangle size-3\" data-kid=\"240\"></i> 88% CONFIDENCE\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 px-6\" data-kid=\"241\">\n            <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\" data-kid=\"242\">\n                <div data-kid=\"243\">\n                    <div class=\"text-[#22C55E] font-mono text-xs mb-4 uppercase tracking-[0.2em] font-bold\" data-kid=\"244\">Security First</div>\n                    <h2 class=\"font-header text-4xl font-bold mb-8 tracking-tight\" data-kid=\"245\">Engineered for Absolute Privacy</h2>\n                    <p class=\"text-[#A1A1AA] text-lg mb-10 leading-relaxed\" data-kid=\"246\">\n                        We analyze the architecture, not store your code. Every analysis happens in an ephemeral container that is wiped after the PR is reviewed.\n                    </p>\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-8 font-mono text-sm text-[#A1A1AA]\" data-kid=\"247\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"248\">\n                            <i class=\"lucide-shield-check text-[#22C55E] shrink-0\" data-kid=\"249\"></i>\n                            <span data-kid=\"250\">Zero Code Retention</span>\n                        </div>\n                        <div class=\"flex items-start gap-3\" data-kid=\"251\">\n                            <i class=\"lucide-lock text-[#22C55E] shrink-0\" data-kid=\"252\"></i>\n                            <span data-kid=\"253\">SOC2 Type II Ready</span>\n                        </div>\n                        <div class=\"flex items-start gap-3\" data-kid=\"254\">\n                            <i class=\"lucide-eye-off text-[#22C55E] shrink-0\" data-kid=\"255\"></i>\n                            <span data-kid=\"256\">Repo-Scoped Access</span>\n                        </div>\n                        <div class=\"flex items-start gap-3\" data-kid=\"257\">\n                            <i class=\"lucide-zap text-[#22C55E] shrink-0\" data-kid=\"258\"></i>\n                            <span data-kid=\"259\">Ephemeral Analysis</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"bg-[#111111] rounded-lg border border-[#2a2a2a] shadow-2xl overflow-hidden group\" data-kid=\"260\">\n                    <div class=\"bg-[#1a1a1a] px-5 py-3 border-b border-[#262626] flex items-center justify-between\" data-kid=\"261\">\n                        <div class=\"flex gap-2\" data-kid=\"262\">\n                            <div class=\"w-3 h-3 rounded-full bg-red-500/40\" data-kid=\"263\"></div>\n                            <div class=\"w-3 h-3 rounded-full bg-orange-500/40\" data-kid=\"264\"></div>\n                            <div class=\"w-3 h-3 rounded-full bg-green-500/40\" data-kid=\"265\"></div>\n                        </div>\n                        <span class=\"text-[10px] font-mono text-[#A1A1AA] tracking-widest uppercase\" data-kid=\"266\">security_policy.yml</span>\n                        <div class=\"w-10\" data-kid=\"267\"></div>\n                    </div>\n                    <div class=\"p-8 font-mono text-sm text-[#A1A1AA] leading-relaxed\" data-kid=\"268\">\n                        <div class=\"text-white\" data-kid=\"269\">version: <span class=\"text-[#22C55E]\" data-kid=\"270\">2.1</span></div>\n                        <div class=\"mt-2\" data-kid=\"271\">encryption:</div>\n                        <div class=\"ml-6\" data-kid=\"272\">algorithm: <span class=\"text-[#22C55E]\" data-kid=\"273\">AES-256-GCM</span></div>\n                        <div class=\"ml-6\" data-kid=\"274\">rotation: <span class=\"text-[#22C55E]\" data-kid=\"275\">daily</span></div>\n                        \n                        <div class=\"mt-4\" data-kid=\"276\">data_policy:</div>\n                        <div class=\"ml-6\" data-kid=\"277\">source_code_retention: <span class=\"text-red-400\" data-kid=\"278\">0s</span></div>\n                        <div class=\"ml-6\" data-kid=\"279\">metadata_expiry: <span class=\"text-orange-400\" data-kid=\"280\">72h</span></div>\n                        \n                        <div class=\"mt-4\" data-kid=\"281\">sandbox_config:</div>\n                        <div class=\"ml-6\" data-kid=\"282\">runtime: <span class=\"text-[#22C55E]\" data-kid=\"283\">gVisor</span></div>\n                        <div class=\"ml-6\" data-kid=\"284\">network_access: <span class=\"text-red-400\" data-kid=\"285\">blocked</span></div>\n                        <div class=\"ml-6\" data-kid=\"286\">ephemeral: <span class=\"text-[#22C55E]\" data-kid=\"287\">true</span></div>\n                        \n                        <div class=\"mt-8 animate-pulse text-[#22C55E] inline-block w-2 h-4 bg-[#22C55E]\" data-kid=\"288\"></div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-24 px-6 bg-[#0F0F0F] monitoring-grid\" data-kid=\"289\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"290\">\n                <div class=\"flex flex-wrap items-end gap-6 h-80\" data-kid=\"291\">\n                    <div class=\"flex-1 min-w-[240px] glass-panel p-8 h-[50%] flex flex-col justify-end group border-b-2 border-b-[#3B82F6]\" data-kid=\"292\">\n                        <div class=\"text-4xl font-header font-bold mb-2 tracking-tight\" data-kid=\"293\">&lt;60s</div>\n                        <div class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-[0.2em]\" data-kid=\"294\">Latency</div>\n                    </div>\n                    <div class=\"flex-1 min-w-[240px] glass-panel p-8 h-[100%] flex flex-col justify-end border-b-4 border-b-[#22C55E]\" data-kid=\"295\">\n                        <div class=\"text-6xl font-header font-bold mb-4 tracking-tighter\" data-kid=\"296\">100%</div>\n                        <div class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-[0.2em]\" data-kid=\"297\">Coverage</div>\n                    </div>\n                    <div class=\"flex-1 min-w-[240px] glass-panel p-8 h-[80%] flex flex-col justify-end border-b-2 border-b-[#F97316]\" data-kid=\"298\">\n                        <div class=\"text-4xl font-header font-bold mb-2 tracking-tight\" data-kid=\"299\">Zero</div>\n                        <div class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-[0.2em]\" data-kid=\"300\">Retention</div>\n                    </div>\n                    <div class=\"flex-1 min-w-[240px] glass-panel p-8 h-[65%] flex flex-col justify-end border-b-2 border-b-[#A855F7]\" data-kid=\"301\">\n                        <div class=\"text-4xl font-header font-bold mb-2 tracking-tight\" data-kid=\"302\">98.2%</div>\n                        <div class=\"text-[10px] font-mono text-[#A1A1AA] uppercase tracking-[0.2em]\" data-kid=\"303\">Accuracy</div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 px-6 relative overflow-hidden\" id=\"final-cta\" data-kid=\"304\">\n            <div class=\"text-behind-bg absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20\" id=\"parallax-text\" data-kid=\"305\">\n                SYSTEM RISK\n            </div>\n            \n            <div class=\"max-w-2xl mx-auto relative z-10 glass-panel p-12 text-center shadow-2xl backdrop-blur-md\" data-kid=\"306\">\n                <h2 class=\"font-header text-4xl font-bold mb-6 leading-tight\" data-kid=\"307\">Review the system, not just the diff.</h2>\n                <p class=\"text-[#A1A1AA] text-lg mb-8 leading-relaxed\" data-kid=\"308\">\n                    Connect your repository today and discover hidden architectural side-effects before they reach production.\n                </p>\n                <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"309\">\n                    <button class=\"w-full sm:w-auto bg-[#22C55E] text-black font-bold px-10 py-4 rounded-xs hover:bg-[#1eb054] transition-all shadow-xl shadow-[#22C55E]/20\" data-kid=\"310\">Connect Repository</button>\n                    <a href=\"#\" class=\"text-sm font-bold border-b border-[#262626] hover:border-[#22C55E] py-1 transition-all\" data-kid=\"311\">View Documentation</a>\n                </div>\n            </div>\n        </section>\n\n        \n        <footer class=\"py-20 px-6 border-t border-[#262626]\" data-kid=\"312\">\n            <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12\" data-kid=\"313\">\n                <div class=\"space-y-6 max-w-sm\" data-kid=\"314\">\n                    <a href=\"/\" class=\"font-header text-xl font-extrabold tracking-tighter flex items-center gap-2\" data-kid=\"315\">\n                        <div class=\"w-6 h-6 bg-[#22C55E] rounded-xs flex items-center justify-center\" data-kid=\"316\">\n                            <div class=\"w-2 h-2 bg-black rounded-full\" data-kid=\"317\"></div>\n                        </div>\n                        <span data-kid=\"318\">GREPAI</span>\n                    </a>\n                    <p class=\"text-sm text-[#A1A1AA] leading-relaxed\" data-kid=\"319\">\n                        Repository-aware PR risk intelligence for high-stakes engineering teams. Understand the system, prevent production failures.\n                    </p>\n                    <div class=\"flex gap-4 text-[#A1A1AA]\" data-kid=\"320\">\n                        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"321\"><i class=\"lucide-twitter size-5\" data-kid=\"322\"></i></a>\n                        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"323\"><i class=\"lucide-github size-5\" data-kid=\"324\"></i></a>\n                        <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"325\"><i class=\"lucide-linkedin size-5\" data-kid=\"326\"></i></a>\n                    </div>\n                </div>\n                \n                <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-12 lg:gap-24\" data-kid=\"327\">\n                    <div class=\"space-y-4\" data-kid=\"328\">\n                        <h5 class=\"text-xs font-mono font-bold text-white uppercase tracking-widest\" data-kid=\"329\">Product</h5>\n                        <ul class=\"space-y-2 text-sm text-[#A1A1AA]\" data-kid=\"330\">\n                            <li data-kid=\"331\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"332\">Risk Engine</a></li>\n                            <li data-kid=\"333\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"334\">Integrations</a></li>\n                            <li data-kid=\"335\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"336\">Security</a></li>\n                            <li data-kid=\"337\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"338\">Pricing</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-4\" data-kid=\"339\">\n                        <h5 class=\"text-xs font-mono font-bold text-white uppercase tracking-widest\" data-kid=\"340\">Resources</h5>\n                        <ul class=\"space-y-2 text-sm text-[#A1A1AA]\" data-kid=\"341\">\n                            <li data-kid=\"342\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"343\">Documentation</a></li>\n                            <li data-kid=\"344\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"345\">Architecture Guide</a></li>\n                            <li data-kid=\"346\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"347\">Blog</a></li>\n                            <li data-kid=\"348\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"349\">Status</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-4\" data-kid=\"350\">\n                        <h5 class=\"text-xs font-mono font-bold text-white uppercase tracking-widest\" data-kid=\"351\">Legal</h5>\n                        <ul class=\"space-y-2 text-sm text-[#A1A1AA]\" data-kid=\"352\">\n                            <li data-kid=\"353\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"354\">Privacy Policy</a></li>\n                            <li data-kid=\"355\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"356\">Terms of Service</a></li>\n                            <li data-kid=\"357\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"358\">DPA</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-[#262626] flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"359\">\n                <p class=\"text-[10px] font-mono text-[#3F3F46]\" data-kid=\"360\">© 2024 GREP AI INC. ALL RIGHTS RESERVED. ANALYZED IN CALIFORNIA.</p>\n                <div class=\"flex items-center gap-4 text-[10px] font-mono text-[#3F3F46]\" data-kid=\"361\">\n                    <div class=\"w-1.5 h-1.5 bg-[#22C55E] rounded-full\" data-kid=\"362\"></div>\n                    SYSTEMS OPERATIONAL\n                </div>\n            </div>\n        </footer>\n    </main>\n\n    \n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"363\">\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"364\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"365\"></script>\n    <script src=\"https://unpkg.com/lucide@latest\" data-kid=\"366\"></script>\n    <script type=\"module\" data-kid=\"367\">\n        import { animate as motionAnimate, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n        import { animate as animeAnimate, stagger } from 'https://esm.sh/animejs@4'\n        import Lenis from \"https://esm.sh/lenis@1\"\n\n        // Initialize Lucide Icons\n        lucide.createIcons();\n\n        // Initialize Smooth Scroll (Lenis/Locomotive Style)\n        const lenis = new Lenis({\n            lerp: 0.1,\n            wheelMultiplier: 1.2,\n            gestureOrientation: 'vertical',\n            normalizeWheel: true,\n            smoothTouch: true\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n\n        // GSAP Plugins\n        gsap.registerPlugin(ScrollTrigger);\n\n        // 1. Panel entrance with inView\n        motionAnimate(\".glass-panel\", { \n            opacity: [0, 1], \n            y: [20, 0] \n        }, { \n            delay: stagger(0.05)\n        });\n\n        // Hero Blast Radius Ripples\n        const rippleContainer = document.querySelector('#hero-ripples');\n        const createRipple = () => {\n            const ripple = document.createElement('div');\n            ripple.className = 'absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 border border-red-500 rounded-full pointer-events-none';\n            ripple.style.width = '10px';\n            ripple.style.height = '10px';\n            rippleContainer.appendChild(ripple);\n            \n            animeAnimate(ripple, {\n                width: [10, 600],\n                height: [10, 600],\n                opacity: [0.8, 0],\n                duration: 5000,\n                ease: 'out(3)',\n                onComplete: () => ripple.remove()\n            });\n        };\n        setInterval(createRipple, 2000);\n\n        // 2. Workflow Pinning (gsap-pin-timeline-sequence)\n        const workflowTl = gsap.timeline({\n            scrollTrigger: {\n                trigger: \"#workflow\",\n                start: \"top top\",\n                end: \"+=1200\", // Tightened\n                pin: true,\n                scrub: 1,\n                anticipatePin: 1\n            }\n        });\n\n        gsap.utils.toArray(\".workflow-step\").forEach((step, i) => {\n            workflowTl.from(step, {\n                opacity: 0,\n                y: 60,\n                scale: 0.98,\n                duration: 1\n            }, i === 0 ? \"\" : \"-=0.3\");\n            \n            if (i < 2) { \n                workflowTl.to(step, {\n                    opacity: 0,\n                    y: -60,\n                    scale: 0.95,\n                    duration: 1\n                }, \"+=0.3\");\n            }\n        });\n\n        // 3. Draggable Reports (simulated drag)\n        const cards = document.querySelectorAll('.risk-card');\n        cards.forEach(card => {\n            let isDragging = false;\n            let startPos = { x: 0, y: 0 };\n            let currentPos = { x: 0, y: 0 };\n\n            card.addEventListener('mousedown', (e) => {\n                isDragging = true;\n                startPos.x = e.clientX - currentPos.x;\n                startPos.y = e.clientY - currentPos.y;\n                card.classList.add('z-50');\n            });\n\n            window.addEventListener('mousemove', (e) => {\n                if (!isDragging) return;\n                currentPos.x = e.clientX - startPos.x;\n                currentPos.y = e.clientY - startPos.y;\n                card.style.transform = `translate(${currentPos.x}px, ${currentPos.y}px)`;\n            });\n\n            window.addEventListener('mouseup', () => {\n                if (!isDragging) return;\n                isDragging = false;\n                animeAnimate(card, {\n                    scale: [1.02, 1],\n                    duration: 400,\n                    ease: 'spring(1, 80, 10, 0)'\n                });\n            });\n        });\n\n        // 4. Final CTA Text Shift (locomotive-progress-hero equivalent)\n        const parallaxText = document.querySelector('#parallax-text');\n        scroll((progress) => {\n            const move = (progress - 0.5) * 80; // Better centering\n            parallaxText.style.transform = `translate(-50%, -50%) translateX(${move}vw)`;\n        }, {\n            target: document.querySelector('#final-cta'),\n            offset: [\"start end\", \"end start\"]\n        });\n\n        // 5. Global Parallax Layers (locomotive-parallax-layers)\n        scroll((progress) => {\n            document.querySelectorAll('[data-scroll-speed]').forEach(el => {\n                const speed = parseFloat(el.dataset.scrollSpeed);\n                const offset = (progress - 0.5) * speed * 200;\n                el.style.transform = `translateY(${offset}px)`;\n            });\n        });\n\n    </script>\n</div>\n",
