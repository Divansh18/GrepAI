      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap');\n\n    :root {\n        --color-bg: #0A0A0A;\n        --color-panel: #111111;\n        --color-border: #262626;\n        --color-text: #FAFAFA;\n        --color-muted: #A1A1AA;\n        --color-accent: #22C55E;\n        --color-error: #EF4444;\n        --color-warning: #F59E0B;\n    }\n\n    body {\n        background-color: var(--color-bg);\n        color: var(--color-text);\n        font-family: 'IBM Plex Sans', sans-serif;\n        margin: 0;\n        overflow-x: clip;\n    }\n\n    .font-mono { font-family: 'IBM Plex Mono', monospace; }\n    .font-sans { font-family: 'IBM Plex Sans', sans-serif; }\n\n    /* Custom Scrollbar for Terminal */\n    .terminal-scroll::-webkit-scrollbar { width: 4px; }\n    .terminal-scroll::-webkit-scrollbar-track { background: transparent; }\n    .terminal-scroll::-webkit-scrollbar-thumb { background: var(--color-border); }\n\n    /* For GSAP animations - ensure no initial hidden state if using gsap.from as per rules */\n    /* But for non-gsap reveals we might use opacity */\n    \n    .cursor {\n        display: inline-block;\n        width: 8px;\n        height: 1.2em;\n        background: var(--color-accent);\n        vertical-align: middle;\n        margin-left: 2px;\n    }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n\n<div class=\"selection:bg-green-500/30\" data-kid=\"2\">\n    \n    <header class=\"fixed top-0 w-full z-50 bg-[#0A0A0A] border-b border-[#262626]\" data-kid=\"3\">\n        <nav class=\"max-w-[1440px] mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"4\">\n            <div class=\"flex items-center gap-3\" data-kid=\"5\">\n                <i class=\"ti ti-terminal-2 text-[#22C55E] text-2xl\" data-kid=\"6\"></i>\n                <span class=\"font-mono font-bold tracking-tighter text-lg uppercase\" data-kid=\"7\">GREPAI</span>\n            </div>\n            <div class=\"hidden lg:flex items-center gap-10\" data-kid=\"8\">\n                <a href=\"#architecture\" class=\"font-mono text-[10px] uppercase tracking-widest text-[#A1A1AA] hover:text-[#FAFAFA] transition-colors\" data-kid=\"9\">Architecture</a>\n                <a href=\"#security\" class=\"font-mono text-[10px] uppercase tracking-widest text-[#A1A1AA] hover:text-[#FAFAFA] transition-colors\" data-kid=\"10\">Security</a>\n                <a href=\"#pricing\" class=\"font-mono text-[10px] uppercase tracking-widest text-[#A1A1AA] hover:text-[#FAFAFA] transition-colors\" data-kid=\"11\">Pricing</a>\n                <a href=\"#docs\" class=\"font-mono text-[10px] uppercase tracking-widest text-[#A1A1AA] hover:text-[#FAFAFA] transition-colors\" data-kid=\"12\">Docs</a>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"13\">\n                <a href=\"https://github.com\" class=\"text-[#A1A1AA] hover:text-[#FAFAFA]\" data-kid=\"14\"><i class=\"ti ti-brand-github text-xl\" data-kid=\"15\"></i></a>\n                <button class=\"font-mono text-[10px] uppercase border border-[#262626] px-5 py-2 hover:bg-[#111111] transition-all\" data-kid=\"16\">\n                    Connect Repository\n                </button>\n            </div>\n        </nav>\n    </header>\n\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"17\">\n\n    <main class=\"pt-16\" data-kid=\"18\">\n        \n        <section class=\"min-h-[90vh] flex items-center px-6 lg:px-20 py-20 border-b border-[#262626]\" data-kid=\"19\">\n            <div class=\"max-w-[1440px] mx-auto w-full grid lg:grid-cols-2 gap-20 items-center\" data-kid=\"20\">\n                <div class=\"space-y-10 hero-text\" data-kid=\"21\">\n                    <div class=\"hero-reveal inline-flex items-center gap-2 px-3 py-1 border border-[#22C55E]/30 bg-[#22C55E]/5 text-[#22C55E] font-mono text-[10px] uppercase tracking-widest\" data-kid=\"22\">\n                        <span class=\"relative flex h-2 w-2\" data-kid=\"23\">\n                          <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22C55E] opacity-75\" data-kid=\"24\"></span>\n                          <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[#22C55E]\" data-kid=\"25\"></span>\n                        </span>\n                        Live System Analysis\n                    </div>\n                    <h1 class=\"hero-reveal font-mono text-5xl lg:text-8xl leading-[0.9] tracking-tighter uppercase font-bold\" data-kid=\"26\">\n                        Repository-aware<br data-kid=\"27\">\n                        <span class=\"text-[#22C55E]\" data-kid=\"28\">PR risk engine.</span>\n                    </h1>\n                    <p class=\"hero-reveal text-[#A1A1AA] text-lg lg:text-xl max-w-lg font-light leading-relaxed\" data-kid=\"29\">\n                        Analyze pull requests in full repository context. surface architectural risks, propagation delays, and hidden production side effects.\n                    </p>\n                    <div class=\"hero-reveal flex flex-wrap gap-6 pt-4\" data-kid=\"30\">\n                        <button class=\"bg-[#22C55E] text-[#0A0A0A] font-mono px-10 py-5 font-bold text-sm hover:scale-[1.02] active:scale-95 transition-all\" data-kid=\"31\">\n                            CONNECT REPOSITORY\n                        </button>\n                        <button class=\"border border-[#262626] text-[#FAFAFA] font-mono px-10 py-5 text-sm hover:bg-[#111111] transition-all flex items-center gap-2\" data-kid=\"32\">\n                            VIEW EXAMPLE ANALYSIS <i class=\"ti ti-arrow-right\" data-kid=\"33\"></i>\n                        </button>\n                    </div>\n                </div>\n\n                \n                <div class=\"hero-terminal bg-[#111111] border border-[#262626] shadow-2xl overflow-hidden font-mono text-[11px] leading-relaxed\" data-kid=\"34\">\n                    <div class=\"bg-[#1A1A1A] border-b border-[#262626] p-3 flex items-center justify-between\" data-kid=\"35\">\n                        <div class=\"flex gap-2\" data-kid=\"36\">\n                            <div class=\"w-3 h-3 border border-[#333]\" data-kid=\"37\"></div>\n                            <div class=\"w-3 h-3 border border-[#333]\" data-kid=\"38\"></div>\n                            <div class=\"w-3 h-3 border border-[#333]\" data-kid=\"39\"></div>\n                        </div>\n                        <div class=\"text-[#A1A1AA] text-[9px] tracking-widest\" data-kid=\"40\">ANALYSIS_OUTPUT :: PR-842</div>\n                        <div class=\"w-10\" data-kid=\"41\"></div>\n                    </div>\n                    <div class=\"p-8 space-y-8 terminal-content\" data-kid=\"42\">\n                        <div class=\"space-y-1\" data-kid=\"43\">\n                            <div class=\"text-[#A1A1AA] uppercase opacity-50\" data-kid=\"44\"># Command</div>\n                            <div class=\"text-[#22C55E]\" data-kid=\"45\">grep-ai --analyze repo:org/core-services pr:842 --deep</div>\n                        </div>\n\n                        <div class=\"grid grid-cols-2 gap-12 border-y border-[#262626] py-6\" data-kid=\"46\">\n                            <div class=\"space-y-2\" data-kid=\"47\">\n                                <div class=\"text-[#A1A1AA] text-[10px]\" data-kid=\"48\">RISK_SCORE</div>\n                                <div class=\"text-3xl text-[#EF4444] font-bold\" data-kid=\"49\">HIGH</div>\n                            </div>\n                            <div class=\"space-y-2\" data-kid=\"50\">\n                                <div class=\"text-[#A1A1AA] text-[10px]\" data-kid=\"51\">CONFIDENCE</div>\n                                <div class=\"text-3xl text-[#22C55E]\" data-kid=\"52\">92.4%</div>\n                            </div>\n                        </div>\n\n                        <div class=\"space-y-4\" data-kid=\"53\">\n                            <div class=\"text-[#A1A1AA] uppercase opacity-50\" data-kid=\"54\">Affected_Systems_Graph</div>\n                            <div class=\"space-y-1.5 font-mono text-[11px]\" data-kid=\"55\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"56\">\n                                    <span class=\"text-[#262626]\" data-kid=\"57\">└──</span>\n                                    <span class=\"text-[#FAFAFA]\" data-kid=\"58\">auth-service</span>\n                                    <span class=\"text-[#EF4444] px-1 bg-[#EF4444]/10 border border-[#EF4444]/20 text-[9px]\" data-kid=\"59\">CRITICAL_PATH</span>\n                                </div>\n                                <div class=\"flex items-center gap-2 pl-4\" data-kid=\"60\">\n                                    <span class=\"text-[#262626]\" data-kid=\"61\">├──</span>\n                                    <span class=\"text-[#A1A1AA]\" data-kid=\"62\">session-manager</span>\n                                    <span class=\"text-[#262626] ml-2\" data-kid=\"63\">--- modified</span>\n                                </div>\n                                <div class=\"flex items-center gap-2 pl-4\" data-kid=\"64\">\n                                    <span class=\"text-[#262626]\" data-kid=\"65\">├──</span>\n                                    <span class=\"text-[#A1A1AA]\" data-kid=\"66\">billing-gateway</span>\n                                    <span class=\"text-[#F59E0B] ml-2\" data-kid=\"67\">[SIDE_EFFECT]</span>\n                                </div>\n                                <div class=\"flex items-center gap-2 pl-8\" data-kid=\"68\">\n                                    <span class=\"text-[#262626]\" data-kid=\"69\">└──</span>\n                        